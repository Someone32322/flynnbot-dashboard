<%- include('partials/head', { title: 'Command Builder' }) %>
<body class="dash-body">
<%- include('partials/nav', { guild, user, activePage: 'commands' }) %>

<div id="cb-app" class="cb-app">
  <!-- ── Top Bar ──────────────────────────────────────────── -->
  <header class="cb-topbar">
    <div class="cb-topbar-left">
      <a href="/dashboard/<%= guild.id %>" class="cb-back-btn" title="Back to dashboard">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      </a>
      <div class="cb-title-wrap">
        <input id="cb-cmd-name" class="cb-cmd-name" type="text" placeholder="Command name..." maxlength="100" autocomplete="off" spellcheck="false" />
        <span id="cb-trigger-badge" class="cb-trigger-badge cb-type-slash">slash</span>
      </div>
    </div>
    <div class="cb-topbar-right">
      <span id="cb-status" class="cb-status cb-status-saved">Saved</span>
      <button id="cb-json-toggle" class="cb-btn cb-btn-ghost" title="Toggle JSON Editor">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        JSON
      </button>
      <button id="cb-import-btn" class="cb-btn cb-btn-ghost" title="Import JSON">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Import
      </button>
      <button id="cb-export-btn" class="cb-btn cb-btn-ghost" title="Export JSON">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export
      </button>
      <button id="cb-sync-btn" class="cb-btn cb-btn-secondary" title="Register/sync slash command with Discord">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        Sync
      </button>
      <button id="cb-save-btn" class="cb-btn cb-btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        Save
      </button>
    </div>
  </header>

  <!-- ── Main layout ───────────────────────────────────────── -->
  <div class="cb-layout">

    <!-- ── Left Sidebar: Block Picker ──────────────────────── -->
    <aside class="cb-sidebar">
      <div class="cb-sidebar-head">
        <div class="cb-search-wrap">
          <svg class="cb-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input id="cb-block-search" type="text" class="cb-search-input" placeholder="Search blocks..." />
        </div>
      </div>
      <div id="cb-block-categories" class="cb-block-categories"></div>
    </aside>

    <!-- ── Canvas ──────────────────────────────────────────── -->
    <main class="cb-canvas">
      <div id="cb-blocks-container" class="cb-blocks-container">
        <!-- Trigger block + action blocks rendered here by JS -->
      </div>
      <div class="cb-canvas-footer">
        <button id="cb-add-first-block" class="cb-add-block-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Block
        </button>
      </div>
    </main>

    <!-- ── JSON Panel ───────────────────────────────────────── -->
    <aside id="cb-json-panel" class="cb-json-panel cb-json-hidden">
      <div class="cb-json-head">
        <span>JSON Preview</span>
        <button id="cb-json-copy" class="cb-btn cb-btn-ghost cb-btn-sm">Copy</button>
      </div>
      <textarea id="cb-json-editor" class="cb-json-editor" spellcheck="false" autocomplete="off" wrap="off"></textarea>
      <div class="cb-json-actions">
        <button id="cb-json-apply" class="cb-btn cb-btn-primary cb-btn-sm">Apply JSON</button>
        <span class="cb-json-hint">Edit JSON directly and click Apply</span>
      </div>
    </aside>
  </div>

  <!-- ── Block Picker Modal ────────────────────────────────── -->
  <div id="cb-picker-modal" class="cb-modal cb-modal-hidden" role="dialog" aria-modal="true" aria-label="Pick a block">
    <div class="cb-modal-backdrop"></div>
    <div class="cb-modal-box">
      <div class="cb-modal-head">
        <h3>Add Block</h3>
        <button class="cb-modal-close" id="cb-picker-close" aria-label="Close">✕</button>
      </div>
      <input id="cb-picker-search" type="text" class="cb-picker-search" placeholder="Search blocks..." autocomplete="off" />
      <div id="cb-picker-list" class="cb-picker-list"></div>
    </div>
  </div>

  <!-- ── Conditions Modal ─────────────────────────────────── -->
  <div id="cb-conditions-modal" class="cb-modal cb-modal-hidden" role="dialog" aria-modal="true" aria-label="Command Conditions">
    <div class="cb-modal-backdrop"></div>
    <div class="cb-modal-box cb-modal-wide">
      <div class="cb-modal-head">
        <h3>Command Conditions</h3>
        <button class="cb-modal-close" id="cb-cond-close">✕</button>
      </div>
      <div class="cb-cond-grid">
        <div class="cb-field-group">
          <label class="cb-label">Allowed Roles <span class="cb-hint">(must have one)</span></label>
          <input id="cond-allowed-roles" type="text" class="cb-input" placeholder="Role IDs, comma-separated" />
        </div>
        <div class="cb-field-group">
          <label class="cb-label">Ignored Roles <span class="cb-hint">(blocked if has any)</span></label>
          <input id="cond-ignored-roles" type="text" class="cb-input" placeholder="Role IDs, comma-separated" />
        </div>
        <div class="cb-field-group">
          <label class="cb-label">Allowed Channels</label>
          <input id="cond-allowed-channels" type="text" class="cb-input" placeholder="Channel IDs, comma-separated" />
        </div>
        <div class="cb-field-group">
          <label class="cb-label">Ignored Channels</label>
          <input id="cond-ignored-channels" type="text" class="cb-input" placeholder="Channel IDs, comma-separated" />
        </div>
        <div class="cb-field-group">
          <label class="cb-label">Cooldown (seconds)</label>
          <input id="cond-cooldown-seconds" type="number" class="cb-input" placeholder="0 = none" min="0" max="86400" />
        </div>
        <div class="cb-field-group">
          <label class="cb-label">Cooldown Scope</label>
          <select id="cond-cooldown-scope" class="cb-select">
            <option value="user">Per User</option>
            <option value="channel">Per Channel</option>
            <option value="guild">Per Server</option>
          </select>
        </div>
        <div class="cb-field-group cb-full">
          <label class="cb-toggle-label">
            <input id="cond-ephemeral" type="checkbox" class="cb-toggle-input" />
            <span class="cb-toggle-track"></span>
            Ephemeral Reply (only visible to triggering user)
          </label>
        </div>
      </div>
      <div class="cb-modal-actions">
        <button id="cb-cond-save" class="cb-btn cb-btn-primary">Save Conditions</button>
      </div>
    </div>
  </div>

  <!-- ── Import Modal ─────────────────────────────────────── -->
  <div id="cb-import-modal" class="cb-modal cb-modal-hidden" role="dialog" aria-modal="true">
    <div class="cb-modal-backdrop"></div>
    <div class="cb-modal-box">
      <div class="cb-modal-head">
        <h3>Import Command JSON</h3>
        <button class="cb-modal-close" id="cb-import-close">✕</button>
      </div>
      <textarea id="cb-import-text" class="cb-json-editor" rows="10" placeholder="Paste exported command JSON here..." spellcheck="false"></textarea>
      <div class="cb-modal-actions">
        <button id="cb-import-confirm" class="cb-btn cb-btn-primary">Import</button>
      </div>
    </div>
  </div>

  <!-- Hidden data passed from server -->
  <script id="cb-server-data" type="application/json"><%- JSON.stringify({
    guildId: guild.id,
    guildName: guild.name,
    cmdId: locals.cmdId || null,
    cmd: locals.cmd ? (typeof locals.cmd === 'string' ? JSON.parse(locals.cmd) : locals.cmd) : null,
  }) %></script>
</div>

<!-- ── Scripts ────────────────────────────────────────────── -->
<script src="/js/command-builder.js?v=20260601"></script>
</body>
</html>
