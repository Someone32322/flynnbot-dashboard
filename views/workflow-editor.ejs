<%- include('partials/head', { title: 'Command Builder' }) %>
<link rel="stylesheet" href="/css/workflow-editor.css?v=2">
<body class="wf-body">
  <%- include('partials/nav') %>

  <%
    const guildIconUrl = guild.icon
      ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.${guild.icon.startsWith('a_') ? 'gif' : 'png'}?size=64`
      : null;

    const cmdJson = typeof cmd !== 'undefined' && cmd
      ? JSON.stringify(cmd).replace(/&/g,'&amp;').replace(/"/g,'&quot;')
      : '';

    const cmdId = typeof cmd !== 'undefined' && cmd
      ? cmd._id.toString()
      : '';

    const TRIGGER_LABELS = [
      { v: '',                l: '— Select Trigger —' },
      { v: 'slash',           l: '/ Slash Command' },
      { v: 'prefix',          l: '! Prefix Command' },
      { v: 'contains',        l: 'Message Contains' },
      { v: 'exact',           l: 'Exact Match' },
      { v: 'regex',           l: 'Regex Pattern' },
      { v: 'startsWith',      l: 'Starts With' },
      { v: 'button',          l: '🔘 Button Click' },
      { v: 'select_menu',     l: '📋 Select Menu' },
      { v: 'reaction_add',    l: '👍 Reaction Added' },
      { v: 'reaction_remove', l: '👎 Reaction Removed' },
      { v: 'member_join',     l: '✅ Member Joins' },
      { v: 'member_leave',    l: '👋 Member Leaves' },
      { v: 'voice_join',      l: '🔊 Voice Join' },
      { v: 'voice_leave',     l: '🔇 Voice Leave' },
      { v: 'message_delete',  l: '🗑️ Message Deleted' },
      { v: 'scheduled',       l: '⏰ Scheduled' },
    ];

    const currentTriggerType = (typeof cmd !== 'undefined' && cmd?.trigger?.type) || '';
    const currentTriggerValue = (typeof cmd !== 'undefined' && cmd?.trigger?.value) || '';
    const needsTriggerValue = ['slash','prefix','contains','exact','regex','startsWith'];
  %>

  <%# ── Hidden data island — read by workflow-editor.js ── %>
  <div id="wfPageData"
    data-guild-id="<%= guild.id %>"
    data-cmd-id="<%= cmdId %>"
    data-cmd-json="<%= cmdJson %>"
    style="display:none">
  </div>

  <div class="wf-editor">

    <%# ── TOP BAR ── %>
    <header class="wf-topbar">
      <a href="/dashboard/<%= guild.id %>#custom-commands" class="wf-topbar__back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        Commands
      </a>
      <div class="wf-topbar__divider"></div>

      <% if (guildIconUrl) { %>
        <img src="<%= guildIconUrl %>" alt="<%= guild.name %>"
          style="width:24px;height:24px;border-radius:50%;flex-shrink:0;">
      <% } %>

      <div class="wf-topbar__name-group">
        <input
          type="text"
          id="wf-name-input"
          class="wf-topbar__name"
          placeholder="command-name"
          maxlength="50"
          autocomplete="off"
          spellcheck="false">
      </div>

      <div class="wf-topbar__divider"></div>

      <div class="wf-topbar__trigger-group">
        <span class="wf-topbar__label">Trigger:</span>
        <select id="wf-trigger-type" class="wf-topbar__select">
          <% for (const t of TRIGGER_LABELS) { %>
            <option value="<%= t.v %>" <%= currentTriggerType === t.v ? 'selected' : '' %>>
              <%= t.l %>
            </option>
          <% } %>
        </select>

        <div id="wf-trigger-value-row"
          <%= needsTriggerValue.includes(currentTriggerType) ? '' : 'hidden' %>>
          <input
            type="text"
            id="wf-trigger-value"
            class="wf-topbar__trigger-val"
            placeholder="command name / pattern"
            maxlength="100"
            autocomplete="off">
        </div>
      </div>

      <div class="wf-topbar__spacer"></div>

      <div class="wf-topbar__stats">
        <span id="wf-step-count" class="wf-topbar__step-count">0 steps</span>
        <span id="wf-autosave" class="wf-topbar__autosave"></span>
      </div>

      <div class="wf-toggle-wrap" title="Enable / disable this workflow">
        <label class="wf-toggle">
          <input type="checkbox" id="wf-enabled-toggle" <%= (typeof cmd === 'undefined' || cmd?.enabled !== false) ? 'checked' : '' %>>
          <span class="wf-toggle__track"></span>
        </label>
        <span class="wf-toggle-label">Enabled</span>
      </div>

      <span id="wf-dirty-dot" class="wf-dirty-dot" title="Unsaved changes"></span>

      <button id="wf-validate-btn" class="wf-btn wf-btn--secondary" type="button">
        Validate
      </button>

      <button id="wf-json-btn" class="wf-btn wf-btn--secondary" type="button" title="View / import command as JSON">
        JSON
      </button>

      <button id="wf-save-btn" class="wf-btn wf-btn--primary" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        Save Command
      </button>
    </header>

    <%# ── SLASH OPTIONS PANEL (shown only when trigger = slash) ── %>
    <div id="wf-slash-options-panel" class="wf-slash-options-panel" style="<%= currentTriggerType === 'slash' ? '' : 'display:none' %>">
      <div class="wf-slash-options-panel__header">
        <div class="wf-slash-options-panel__title">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          Slash Command Options
        </div>
        <button id="wf-add-slash-option" class="wf-btn wf-btn--sm wf-btn--secondary" type="button">+ Add Option</button>
      </div>
      <div id="wf-slash-options-list" class="wf-slash-options-list"></div>
      <p class="wf-slash-options-panel__hint">
        Use <code>{option.name}</code> in your blocks to reference an option's value at runtime.
      </p>
    </div>

    <%# ── EVENT TRIGGER CONFIG PANEL (shown for event-based triggers) ── %>
    <div id="wf-event-trigger-panel" class="wf-event-trigger-panel" style="display:none">

      <%# Reaction triggers: emoji + message ID filters %>
      <div class="et-section" data-for="reaction_add reaction_remove">
        <span class="et-label">Emoji filter</span>
        <input id="et-emoji" type="text" class="et-input" placeholder="Optional: e.g. 👍 or emoji ID (leave blank for any)">
        <span class="et-sep"></span>
        <span class="et-label">Message ID filter</span>
        <input id="et-message-id" type="text" class="et-input" placeholder="Optional: only trigger for reactions on this message ID">
      </div>

      <%# Voice / message_delete: channel filter %>
      <div class="et-section" data-for="voice_join voice_leave message_delete">
        <span class="et-label">Channel filter</span>
        <input id="et-channel-id" type="text" class="et-input" placeholder="Optional: channel ID (leave blank for any channel)">
      </div>

      <%# Scheduled: interval selector %>
      <div class="et-section" data-for="scheduled">
        <span class="et-label">Run interval</span>
        <select id="et-interval" class="et-select">
          <option value="1m">Every 1 minute</option>
          <option value="5m">Every 5 minutes</option>
          <option value="15m">Every 15 minutes</option>
          <option value="30m">Every 30 minutes</option>
          <option value="1h" selected>Every 1 hour</option>
          <option value="6h">Every 6 hours</option>
          <option value="12h">Every 12 hours</option>
          <option value="24h">Every 24 hours</option>
        </select>
      </div>

    </div>

    <%# ── PALETTE (left) ── %>
    <aside id="wf-palette" class="wf-palette" role="complementary" aria-label="Block palette"></aside>

    <%# ── CANVAS (centre) ── %>
    <main id="wf-canvas" class="wf-canvas" role="main" aria-label="Workflow canvas"
      aria-dropeffect="copy"></main>

    <%# ── PROPERTIES PANEL (right) ── %>
    <aside id="wf-props" class="wf-props" role="complementary" aria-label="Block properties">
      <p class="wf-props__empty">Select a block to edit its properties.</p>
    </aside>

  </div><%# /.wf-editor %>

  <%# ── Scripts ── %>
  <script src="/js/theme.js"></script>
  <script src="/js/savebar.js"></script>
  <script src="/js/workflow-registry.js"></script>
  <script src="/js/workflow-editor.js"></script>
</body>
</html>
