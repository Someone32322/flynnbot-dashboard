  <div id="pageData" data-guild-id="<%= guildId %>" style="display:none"></div>

  <style>
    .logging-test-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1rem;
      margin: 1rem 0;
    }

    .test-event-card {
      background: var(--bg-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      transition: all 0.2s;
    }

    .test-event-card:hover {
      border-color: var(--accent);
      background: var(--bg-3);
    }

    .test-event-card.loading {
      opacity: 0.6;
      pointer-events: none;
    }

    .test-event-card.success {
      border-color: #57f287;
      background: rgba(87, 242, 135, 0.1);
    }

    .test-event-card.error {
      border-color: #da373c;
      background: rgba(218, 55, 60, 0.1);
    }

    .test-event-title {
      font-weight: 600;
      font-size: 0.95rem;
    }

    .test-event-desc {
      font-size: 0.8rem;
      opacity: 0.7;
      margin: 0;
    }

    .test-event-status {
      font-size: 0.75rem;
      font-family: monospace;
      padding: 0.5rem;
      background: var(--bg-3);
      border-radius: 4px;
      color: var(--text-2);
    }

    .test-event-btn {
      padding: 0.5rem 1rem;
      background: var(--accent);
      border: none;
      border-radius: 4px;
      color: white;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.2s;
    }

    .test-event-btn:hover:not(:disabled) {
      background: var(--accent-hover, #4752c4);
      transform: translateY(-1px);
    }

    .test-event-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    #resultsContent {
      color: var(--text-2);
      white-space: pre-wrap;
      word-break: break-all;
    }
  </style>

