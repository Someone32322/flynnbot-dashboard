    let guildId = null;
    let currentGroup = 'channels';

    function init() {
      const pageData = document.getElementById('pageData');
      guildId = pageData?.dataset?.guildId;
      if (!guildId) {
        document.getElementById('testGrid').innerHTML = '<p class="error-text">Guild ID not found</p>';
        return;
      }

      document.querySelectorAll('[data-test-group]').forEach((btn) => {
        btn.addEventListener('click', () => switchGroup(btn.dataset.testGroup));
      });

      switchGroup('channels');
    }

    function switchGroup(group) {
      currentGroup = group;
      renderTestCards();
      document.querySelectorAll('[data-test-group]').forEach((b) => {
        b.classList.toggle('active', b.dataset.testGroup === group);
      });
    }

    function renderTestCards() {
      const grid = document.getElementById('testGrid');
      const events = LOG_EVENTS[currentGroup] || [];
      grid.innerHTML = '';

      for (const evt of events) {
        const card = document.createElement('div');
        card.className = 'test-event-card';
        card.dataset.eventKey = evt.key;

        card.innerHTML = `
          <div class="test-event-title">${evt.label}</div>
          <p class="test-event-desc">Event Type: <code>${evt.key}</code></p>
          <div class="test-event-status">Not tested</div>
          <button class="test-event-btn">Send Test</button>
        `;

        const btn = card.querySelector('.test-event-btn');
        btn.addEventListener('click', () => sendTest(evt.key, btn));
        grid.appendChild(card);
      }
    }

    async function sendTest(eventKey, btn) {
      btn.disabled = true;
      btn.textContent = '⏳ Testing…';
      const card = btn.closest('.test-event-card');
      const status = card.querySelector('.test-event-status');

      try {
        const res = await fetch(`/api/guild/${guildId}/logging/test`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ eventKey }),
        });

        const data = await res.json();

        if (res.ok) {
          card.classList.add('success');
          card.classList.remove('error');
          status.textContent = `✅ Sent! Message ID: ${data.messageId}`;
          btn.textContent = '✅ Success';
          addResult(`✅ ${eventKey}: Sent to channel ${data.channelId}`);
        } else {
          card.classList.add('error');
          card.classList.remove('success');
          status.textContent = `❌ ${data.error || 'Unknown error'}`;
          btn.textContent = '❌ Failed';
          addResult(`❌ ${eventKey}: ${data.error}`);
        }
      } catch (err) {
        card.classList.add('error');
        card.classList.remove('success');
        status.textContent = `❌ ${err.message}`;
        btn.textContent = '❌ Error';
        addResult(`❌ ${eventKey}: ${err.message}`);
      } finally {
        btn.disabled = false;
      }
    }

    function addResult(msg) {
      const resultsEl = document.getElementById('testResults');
      const content = document.getElementById('resultsContent');
      resultsEl.style.display = 'block';
      content.textContent += (content.textContent ? '\n' : '') + msg;
      content.scrollTop = content.scrollHeight;
    }

    init();
  </script>
</body>
</html>
