<%- include('partials/head', { title: 'Changelog' }) %>
<body class="dashboard-body dark-theme">
    <%- include('partials/nav') %>
    
    <div class="cl-page-wrap">
        <main>
            <header class="cl-page-header">
                <div class="cl-header-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                </div>
                <div>
                    <h1>Changelog</h1>
                    <p>Latest updates, features and fixes to the dashboard.</p>
                </div>
            </header>

            <div class="changelog-container">
                <div class="timeline">
                    <% if (changelog && changelog.length > 0) { %>
                        <% changelog.forEach((release) => { %>
                            <a href="/changelog/<%= release.id %>" class="release-card-link">
                            <article class="release-card card" id="<%= release.id %>">
                                <div class="release-header">
                                    <div class="release-meta">
                                        <h2 class="version-link"><%= release.version %></h2>
                                        <% if (release.type === 'major') { %>
                                            <span class="badge major">MAJOR</span>
                                        <% } else if (release.type === 'minor') { %>
                                            <span class="badge minor">MINOR</span>
                                        <% } else { %>
                                            <span class="badge patch">PATCH</span>
                                        <% } %>
                                        <span class="release-date"><%= release.releaseDate %></span>
                                    </div>
                                    <h3 class="release-title"><%= release.title %></h3>
                                    <% if (release.description) { %>
                                        <p class="release-desc"><%= release.description %></p>
                                    <% } %>
                                </div>

                                <div class="release-body">
                                    <% release.features.forEach((featGroup) => { %>
                                        <div class="feature-group">
                                            <h4 class="category-title <%= featGroup.category.toLowerCase() %>">
                                                <%= featGroup.category %>
                                            </h4>
                                            <ul class="feature-list">
                                                <% featGroup.items.forEach((item) => { %>
                                                    <li><%= item %></li>
                                                <% }) %>
                                            </ul>
                                        </div>
                                    <% }) %>
                                </div>
                            </article>
                            </a>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-state">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48" style="opacity:.4"><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M17 2h2a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h2"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
                            <h3>No changelogs yet.</h3>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>
    
    <%- include('partials/footer') %>
</body>
</html>
