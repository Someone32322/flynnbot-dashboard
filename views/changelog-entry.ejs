<%- include('partials/head', { title: entry.version + ' — Changelog' }) %>
<body class="dashboard-body dark-theme">
    <%- include('partials/nav') %>

    <div class="page">
        <main>
            <a href="/changelog" class="cl-back-link">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="15 18 9 12 15 6"/></svg>
                All Changelogs
            </a>

            <article class="release-card card" style="max-width: 800px; margin: 0 auto; padding: 36px;">
                <div class="release-header">
                    <div class="release-meta">
                        <h1 class="version-link" style="font-size: 2rem; font-weight: 700; color: var(--text); margin: 0;"><%= entry.version %></h1>
                        <% if (entry.type === 'major') { %>
                            <span class="badge major">MAJOR</span>
                        <% } else if (entry.type === 'minor') { %>
                            <span class="badge minor">MINOR</span>
                        <% } else { %>
                            <span class="badge patch">PATCH</span>
                        <% } %>
                        <span class="release-date"><%= entry.releaseDate %></span>
                    </div>
                    <h2 class="release-title" style="font-size: 1.4rem; margin-top: 12px;"><%= entry.title %></h2>
                    <% if (entry.description) { %>
                        <p class="release-desc" style="margin-top: 8px;"><%= entry.description %></p>
                    <% } %>
                </div>

                <div class="release-body">
                    <% entry.features.forEach((featGroup) => { %>
                        <div class="feature-group">
                            <h4 class="cl-cat-title cl-cat-title--<%= featGroup.category.toLowerCase().replace(/\s+/g, '-') %>">
                                <%= featGroup.category %>
                            </h4>
                            <ul class="feature-list">
                                <% featGroup.items.forEach((item) => { %>
                                    <li><%= item %></li>
                                <% }) %>
                            </ul>
                        </div>
                    <% }) %>
                </div>
            </article>

            <div style="max-width: 800px; margin: 32px auto 0;">
                <a href="/changelog" class="cl-back-link" style="font-size: 0.9rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="15 18 9 12 15 6"/></svg>
                    Back to Changelog
                </a>
            </div>
        </main>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
