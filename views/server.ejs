<%- include('partials/head', { title: guild.name }) %>
<body>
  <%- include('partials/nav') %>

  <%
    const iconUrl = guild.icon
      ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.${guild.icon.startsWith('a_') ? 'gif' : 'png'}?size=128`
      : null;
    const avatarUrl = user && user.avatar
      ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=128`
      : `https://cdn.discordapp.com/embed/avatars/0.png`;
  %>

  <div class="dash-layout">

    <!-- ===== SIDEBAR ===== -->
    <aside class="dash-sidebar" id="dashSidebar">

      <div class="sidebar-guild">
        <div class="sidebar-guild-icon">
          <% if (iconUrl) { %>
            <img src="<%= iconUrl %>" alt="<%= guild.name %>" class="sidebar-guild-img">
          <% } else { %>
            <img src="/images/flynn.png" alt="Flynn default icon" class="sidebar-guild-img sidebar-guild-default">
          <% } %>
          <div class="sidebar-guild-glow"></div>
        </div>
        <div class="sidebar-guild-name"><%= guild.name %></div>
        <div class="sidebar-guild-badge">Administrator</div>
      </div>

      <div class="sidebar-search-wrap">
        <input
          type="text"
          id="sectionQuickSearch"
          class="sidebar-search"
          placeholder="Search sections..."
          aria-label="Search dashboard sections"
        >
      </div>

      <nav class="sidebar-nav" aria-label="Server navigation">
        <div class="sidebar-nav-group">
          <div class="sidebar-nav-label">Overview</div>
          <button class="sidebar-nav-item" data-section="home">
            <span class="sidebar-nav-icon">🏠</span>
            <span class="sidebar-nav-text">Home</span>
          </button>
        </div>
        <div class="sidebar-nav-group">
          <div class="sidebar-nav-label">Configuration</div>
          <button class="sidebar-nav-item" data-section="commands">
            <span class="sidebar-nav-icon">⚡</span>
            <span class="sidebar-nav-text">Commands</span>
            <span class="sidebar-nav-badge" id="sidebar-cmd-count"></span>
          </button>
          <button class="sidebar-nav-item" data-section="applications">
            <span class="sidebar-nav-icon">🧾</span>
            <span class="sidebar-nav-text">Applications</span>
          </button>
          <button class="sidebar-nav-item" data-section="logging">
            <span class="sidebar-nav-icon">📋</span>
            <span class="sidebar-nav-text">Logging</span>
          </button>
        </div>
        <div class="sidebar-nav-group">
          <div class="sidebar-nav-label">Engagement</div>
          <button class="sidebar-nav-item" data-section="embeds">
            <span class="sidebar-nav-icon">📨</span>
            <span class="sidebar-nav-text">Messages</span>
          </button>
          <button class="sidebar-nav-item" data-section="reaction-roles">
            <span class="sidebar-nav-icon">🎭</span>
            <span class="sidebar-nav-text">Reaction Roles</span>
          </button>
          <button class="sidebar-nav-item" data-section="levels">
            <span class="sidebar-nav-icon">⭐</span>
            <span class="sidebar-nav-text">Leveling</span>
          </button>
        </div>
      </nav>

      <div class="sidebar-footer">
        <a href="/dashboard" class="sidebar-back-btn">
          <span>←</span> All Servers
        </a>
      </div>

    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="dash-main" id="dashMain">

      <header class="dash-command-bar">
        <div class="dash-command-meta">
          <div class="dash-command-guild">
            <% if (iconUrl) { %>
              <img src="<%= iconUrl %>" alt="<%= guild.name %>" class="dash-command-guild-icon">
            <% } else { %>
              <img src="/images/flynn.png" alt="Flynn default icon" class="dash-command-guild-icon">
            <% } %>
            <div>
              <div class="dash-command-label">Active Server</div>
              <div class="dash-command-name"><%= guild.name %></div>
            </div>
          </div>
          <div class="dash-command-helper">Tip: use quick switch to jump between modules instantly.</div>
        </div>
        <div class="dash-quick-nav" aria-label="Quick section navigation">
          <button class="quick-nav-btn" type="button" data-section="commands">Commands</button>
          <button class="quick-nav-btn" type="button" data-section="applications">Applications</button>
          <button class="quick-nav-btn" type="button" data-section="embeds">Messages</button>
          <button class="quick-nav-btn" type="button" data-section="reaction-roles">Reaction Roles</button>
          <button class="quick-nav-btn" type="button" data-section="levels">Leveling</button>
          <button class="quick-nav-btn" type="button" data-section="logging">Logging</button>
        </div>
      </header>

      <!-- ── HOME SECTION ── -->
      <section class="dash-section" id="section-home" data-section="home">

        <div class="home-welcome">
          <div class="home-welcome-orb"></div>
          <div class="home-welcome-content">
            <% if (user) { %>
              <img src="<%= avatarUrl %>" alt="" class="home-welcome-avatar">
            <% } %>
            <div>
              <% if (user) { %>
                <h1 class="home-welcome-title">Welcome back, <span class="gradient-text"><%= user.username %></span></h1>
              <% } else { %>
                <h1 class="home-welcome-title"><span class="gradient-text"><%= guild.name %></span></h1>
              <% } %>
              <p class="home-welcome-sub">Managing <strong><%= guild.name %></strong> — select a feature below to get started.</p>
            </div>
          </div>
        </div>

        <div class="home-section-label">Dashboard Features</div>

        <div class="home-cards-grid">

          <div class="home-card animate-in" data-goto="commands">
            <div class="home-card-icon-wrap">
              <div class="home-card-icon">⚡</div>
            </div>
            <div class="home-card-body">
              <div class="home-card-title">Commands</div>
              <div class="home-card-desc">Enable and configure slash commands for your server. Set role restrictions, allowed channels, and custom descriptions.</div>
              <div class="home-card-stats" id="home-cmd-stats">Loading…</div>
            </div>
            <div class="home-card-arrow">→</div>
          </div>

          <div class="home-card animate-in" data-goto="commands">
            <div class="home-card-icon-wrap home-card-icon-wrap--alt">
              <div class="home-card-icon">🔧</div>
            </div>
            <div class="home-card-body">
              <div class="home-card-title">Prefix Settings</div>
              <div class="home-card-desc">Configure text-based prefix commands. Set custom prefixes up to 5 and control which commands respond to them.</div>
              <div class="home-card-stats" id="home-prefix-stats">Loading…</div>
            </div>
            <div class="home-card-arrow">→</div>
          </div>

          <div class="home-card animate-in" data-goto="levels">
            <div class="home-card-icon-wrap" style="background:linear-gradient(135deg,rgba(15,82,186,.25),rgba(30,111,255,.15))">
              <div class="home-card-icon">⭐</div>
            </div>
            <div class="home-card-body">
              <div class="home-card-title">Leveling</div>
              <div class="home-card-desc">Configure XP rates, level-up messages, role rewards, and manage your server leaderboard.</div>
              <div class="home-card-stats" id="home-levels-stats">Loading…</div>
            </div>
            <div class="home-card-arrow">→</div>
          </div>

          <div class="home-card animate-in" data-goto="applications">
            <div class="home-card-icon-wrap" style="background:linear-gradient(135deg,rgba(14,165,233,.22),rgba(34,211,238,.1));border-color:rgba(34,211,238,.25)">
              <div class="home-card-icon">🧾</div>
            </div>
            <div class="home-card-body">
              <div class="home-card-title">Applications</div>
              <div class="home-card-desc">Build custom forms, automate review flow, and notify applicants with branded DM templates.</div>
              <div class="home-card-stats">Submission workflow ready</div>
            </div>
            <div class="home-card-arrow">→</div>
          </div>

          <div class="home-card animate-in" data-goto="embeds">
            <div class="home-card-icon-wrap" style="background:linear-gradient(135deg,rgba(167,139,250,.24),rgba(139,92,246,.1));border-color:rgba(167,139,250,.25)">
              <div class="home-card-icon">📨</div>
            </div>
            <div class="home-card-body">
              <div class="home-card-title">Message Builder</div>
              <div class="home-card-desc">Create polished embeds, schedule announcements, add components, and preview exactly as users will see it.</div>
              <div class="home-card-stats">Live preview enabled</div>
            </div>
            <div class="home-card-arrow">→</div>
          </div>

          <div class="home-card animate-in" data-goto="reaction-roles">
            <div class="home-card-icon-wrap" style="background:linear-gradient(135deg,rgba(251,146,60,.24),rgba(245,158,11,.1));border-color:rgba(251,146,60,.26)">
              <div class="home-card-icon">🎭</div>
            </div>
            <div class="home-card-body">
              <div class="home-card-title">Reaction Roles</div>
              <div class="home-card-desc">Offer self-serve roles with buttons, dropdowns, or emoji and fine-tune access for each audience.</div>
              <div class="home-card-stats">Self-assignment ready</div>
            </div>
            <div class="home-card-arrow">→</div>
          </div>

        </div>

        <div class="workspace-prefs animate-in">
          <div class="workspace-prefs-head">
            <h3>Workspace Preferences</h3>
            <p>Customize how your dashboard feels without affecting bot behavior.</p>
          </div>
          <div class="workspace-prefs-grid">
            <label class="workspace-pref-item">
              <input type="checkbox" id="prefCompactMode">
              <span>
                <strong>Compact Layout</strong>
                <small>Fit more controls on screen with tighter spacing.</small>
              </span>
            </label>
            <label class="workspace-pref-item">
              <input type="checkbox" id="prefReducedMotion">
              <span>
                <strong>Reduce Motion</strong>
                <small>Use minimal animation for distraction-free admin work.</small>
              </span>
            </label>
          </div>
        </div>
      </section>

      <!-- ── APPLICATIONS SECTION ── -->
      <section class="dash-section" id="section-applications" data-section="applications" style="display:none">
        <div class="section-header">
          <div>
            <h2 class="section-page-title">Applications</h2>
            <p class="section-page-sub">Create fully customizable application forms, control abuse protections, and route submissions to a channel or specific reviewer.</p>
          </div>
          <button class="btn btn-primary" id="appNewBtn">+ New Application</button>
        </div>

        <div class="apps-toolbar">
          <a class="btn btn-ghost" id="appReviewPageBtn" href="/dashboard/<%= guild.id %>/applications/review">Open Review Page</a>
          <div id="appGlobalStatus" class="apps-global-status">Ready</div>
        </div>

        <div id="appsList" class="apps-list">
          <div class="commands-loading"><div class="spinner"></div>Loading applications…</div>
        </div>

        <div id="appEditorBackdrop" class="modal-backdrop" aria-hidden="true">
          <div class="modal app-editor-modal" role="dialog" aria-modal="true">
            <button class="modal-close" id="appEditorClose" aria-label="Close">✕</button>
            <h3 id="appEditorTitle">Create Application</h3>
            <p class="app-editor-sub">Design your own onboarding flow with custom fields, style, and anti-abuse controls.</p>

            <div class="app-editor-grid">
              <label class="rr-label">Application Name <span class="required">*</span>
                <input type="text" id="appName" maxlength="80" placeholder="e.g. Staff Application">
              </label>

              <label class="rr-label">Description
                <textarea id="appDescription" rows="2" maxlength="1200" placeholder="What is this application for?"></textarea>
              </label>

              <div class="app-two-cols">
                <label class="rr-label">Send Results To Type <span class="required">*</span>
                  <select id="appRecipientType">
                    <option value="channel">Channel</option>
                    <option value="user">User</option>
                  </select>
                </label>
                <label class="rr-label">Target ID <span class="required">*</span>
                  <input type="text" id="appRecipientTargetId" maxlength="30" placeholder="Discord channel/user ID">
                </label>
              </div>

              <label class="rr-label">Reviewer Role IDs (comma-separated)
                <input type="text" id="appReviewerRoleIds" placeholder="123, 456, 789">
              </label>

              <label class="rr-label">Transcript Channel ID
                <input type="text" id="appTranscriptChannelId" maxlength="30" placeholder="Channel ID to post transcripts when a submission is deleted (optional)">
              </label>

              <div class="app-two-cols">
                <label class="rr-label">Accent Color
                  <input type="color" id="appStyleAccent" value="#22d3ee">
                </label>
                <label class="rr-label">Animation Preset
                  <select id="appStyleAnim">
                    <option value="wave">Wave</option>
                    <option value="pulse">Pulse</option>
                    <option value="float">Float</option>
                  </select>
                </label>
              </div>

              <div class="app-editor-switches">
                <label><input type="checkbox" id="appIsActive" checked> Application Open</label>
                <label><input type="checkbox" id="appOnePerUser" checked> One Submission Per User</label>
                <label><input type="checkbox" id="appBlockPending" checked> Block New While Pending</label>
              </div>

              <div class="app-two-cols">
                <label class="rr-label">Cooldown Minutes
                  <input type="number" id="appCooldown" min="0" max="10080" value="60">
                </label>
                <label class="rr-label">Max Submissions Per User
                  <input type="number" id="appMaxSubmissions" min="1" max="1000" value="3">
                </label>
              </div>

              <div class="app-builder-section">
                <div class="app-builder-header">
                  <h4>Form Builder</h4>
                  <div class="app-builder-actions">
                    <button class="btn btn-ghost btn-sm" id="appAddSectionBtn" type="button">+ Section</button>
                    <button class="btn btn-secondary btn-sm" id="appAddQuestionBtn" type="button">+ Question</button>
                  </div>
                </div>
                <div id="appFieldBuilder" class="app-field-builder"></div>
                <p class="app-builder-tip">Tip: build like Google Forms. Add section blocks to split your form, then add questions under each section.</p>
              </div>

              <div class="app-builder-section">
                <div class="app-builder-header">
                  <h4>Status Update Messages</h4>
                  <label class="app-notify-toggle"><input type="checkbox" id="appNotifyEnabled" checked> Notify applicant on status updates</label>
                  <label class="app-notify-toggle"><input type="checkbox" id="appShowApplicationField" checked> Include "Application" field in embed</label>
                  <label class="app-notify-toggle"><input type="checkbox" id="appShowStatusField" checked> Include "New Status" field in embed</label>
                </div>
                <p class="app-builder-tip">For each status, choose no DM, generic embed, or a saved embed template from the Messages/Embeds area.</p>
                <div id="appStatusTemplates" class="app-status-templates"></div>
              </div>

              <details class="app-advanced-json">
                <summary>Advanced JSON (optional)</summary>
                <label class="rr-label">Fields JSON
                  <textarea id="appFieldsJson" rows="8" class="app-json-input" spellcheck="false"></textarea>
                </label>
              </details>

              <div class="app-editor-actions">
                <button class="btn btn-secondary" id="appEditorCancel">Cancel</button>
                <button class="btn btn-primary" id="appEditorSave">Save Application</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── COMMANDS SECTION ── -->
      <section class="dash-section" id="section-commands" data-section="commands" style="display:none">

        <div class="section-header">
          <div>
            <h2 class="section-page-title">Commands</h2>
            <p class="section-page-sub">Enable commands and configure them per-server. Only enabled commands appear in Discord.</p>
          </div>
          <input type="text" id="commandSearch" class="commands-search" placeholder="Search commands…" aria-label="Search commands">
        </div>

        <div class="category-tabs" id="categoryTabs">
          <button class="cat-tab active" data-cat="all">All</button>
          <button class="cat-tab" data-cat="Moderation">Moderation</button>
          <button class="cat-tab" data-cat="Levels">Levels</button>
          <button class="cat-tab" data-cat="Admin">Admin</button>
          <button class="cat-tab" data-cat="General">General</button>
          <button class="cat-tab" data-cat="Info">Info</button>
          <button class="cat-tab" data-cat="Message">Message</button>
        </div>

        <div id="commandsList" class="commands-list">
          <div class="commands-loading">
            <div class="spinner"></div>
            Loading commands…
          </div>
        </div>

      </section>

      <!-- ── LOGGING SECTION ── -->
      <section class="dash-section" id="section-logging" data-section="logging" style="display:none">
        <div class="section-header">
          <h2 class="section-title">📋 Logging</h2>
          <p class="section-subtitle">Choose a channel for each type of event. Select "Not logging" to disable an event.</p>
        </div>
        <div id="loggingContent">
          <div class="commands-loading"><div class="spinner"></div>Loading logging config…</div>
        </div>
        <div class="logging-save-row" id="loggingSaveRow" style="display:none">
          <button class="btn btn-primary" id="loggingSaveBtn">Save Logging Config</button>
          <span class="save-status" id="loggingSaveStatus"></span>
        </div>
      </section>

      <!-- ── MESSAGE BUILDER SECTION ── -->
      <section class="dash-section" id="section-embeds" data-section="embeds" style="display:none">

        <!-- Top bar -->
        <div class="builder-topbar">
          <div class="builder-topbar-left">
            <h2>📨 Message Builder</h2>
            <p>Build rich messages with embeds, schedule them, use webhooks, sticky messages, and command triggers.</p>
          </div>
          <button class="btn btn-primary" id="builderNewBtn">+ New Message</button>
        </div>

        <!-- Saved messages horizontal strip -->
        <div class="builder-list-strip" id="builderListStrip"></div>

        <!-- Editor (shown when editing) -->
        <div id="builderEditor" class="builder-editor" style="display:none">

          <!-- Editor header with name input + action buttons -->
          <div class="builder-editor-header">
            <input type="text" id="builderEditorMsgName" class="builder-editor-name-input"
              maxlength="60" placeholder="Message name…">
            <div class="builder-editor-btns">
              <button class="btn btn-secondary" id="builderEditorBack">← Back</button>
              <button class="btn btn-primary"   id="builderSaveBtn">💾 Save</button>
              <button class="btn btn-success"   id="builderSendNowBtn">▶ Send Now</button>
            </div>
          </div>

          <!-- Split panel -->
          <div class="builder-split">

            <!-- LEFT: form -->
            <div class="builder-left">

              <!-- Content section -->
              <div class="bsec open">
                <div class="bsec-header" data-collapsible>
                  <div class="bsec-header-left">
                    <span class="bsec-icon">📝</span> Content
                  </div>
                  <span class="bsec-chevron">▾</span>
                </div>
                <div class="bsec-body">
                  <p class="bf-hint">Plain text that appears above embeds. Supports Discord markdown and <code>{variables}</code>.</p>
                  <label class="bf-label">
                    Message Content
                    <textarea id="builderContent" rows="4" maxlength="2000"
                      placeholder="Message content (optional)… Use {user}, {server}, {membercount}, {date}, {time}, {channel}"></textarea>
                  </label>
                  <div class="bf-char"><span id="builderContentCount">0</span> / 2000</div>
                </div>
              </div>

              <!-- Embeds section -->
              <div class="bsec open">
                <div class="bsec-header" style="cursor:default">
                  <div class="bsec-header-left">
                    <span class="bsec-icon">📦</span> Embeds
                    <small style="font-weight:400;opacity:.6;font-size:0.78rem">(up to 10)</small>
                  </div>
                  <button class="btn btn-sm" id="builderAddEmbedBtn" style="margin-left:auto">+ Add Embed</button>
                </div>
                <div class="bsec-body" id="builderEmbedsBody">
                  <div id="builderEmbedsList"></div>
                  <p id="builderEmbedsEmpty" style="font-size:0.82rem;color:var(--text-2);margin:0">
                    No embeds yet. Click <strong>+ Add Embed</strong> above.
                  </p>
                </div>
              </div>

              <!-- Delivery section -->
              <div class="bsec open">
                <div class="bsec-header" data-collapsible>
                  <div class="bsec-header-left">
                    <span class="bsec-icon">📅</span> Delivery
                  </div>
                  <span class="bsec-chevron">▾</span>
                </div>
                <div class="bsec-body">
                  <div class="delivery-type-grid" id="deliveryTypeGrid"></div>
                  <div class="delivery-config" id="deliveryConfig"></div>
                </div>
              </div>

              <!-- Action Rows section -->
              <div class="bsec open" id="actionRowsSec">
                <div class="bsec-header" style="cursor:default">
                  <div class="bsec-header-left">
                    <span class="bsec-icon">🔘</span> Action Rows
                    <small style="font-weight:400;opacity:.6;font-size:0.78rem">(up to 5 rows)</small>
                  </div>
                  <button class="btn btn-sm" id="builderAddRowBtn" style="margin-left:auto">+ Add Row</button>
                </div>
                <div class="bsec-body" id="builderActionRowsBody">
                  <p class="bf-hint" style="margin-bottom:0.25rem">Add buttons, select menus, or emoji reaction bindings to your message. <strong>Buttons</strong> and <strong>Select Menus</strong> require the message to be sent by the bot. <strong>Emoji Reactions</strong> can be attached to any message.</p>
                  <div id="builderActionRowsList"></div>
                  <p id="builderActionRowsEmpty" class="bf-hint" style="background:none;border:none;padding:0;text-align:center;margin:0">No action rows yet — click <strong>+ Add Row</strong> above.</p>
                  <button class="btn btn-sm" id="builderAttachMsgBtn" style="margin-top:0.5rem;width:100%;background:rgba(88,101,242,0.12);border-color:rgba(88,101,242,0.3);color:#a5b4fc">🔗 Attach to Existing Message</button>
                </div>
              </div>

              <!-- Variables reference (collapsible) -->
              <div class="bsec">
                <div class="bsec-header" data-collapsible>
                  <div class="bsec-header-left">
                    <span class="bsec-icon">📚</span> Available Variables
                  </div>
                  <span class="bsec-chevron">▾</span>
                </div>
                <div class="bsec-body">
                  <p class="bf-hint">Use these variables in your content, embed titles, descriptions, author/footer text, and field values. The bot will replace them when sending.</p>
                  <div class="vars-grid">
                    <code>{user}</code>       <span>Mentions the user (e.g. who triggered the command)</span>
                    <code>{username}</code>   <span>User's display name</span>
                    <code>{server}</code>     <span>Server name</span>
                    <code>{serverid}</code>   <span>Server ID</span>
                    <code>{membercount}</code><span>Current member count</span>
                    <code>{date}</code>       <span>Today's date (e.g. Monday, January 1, 2025)</span>
                    <code>{time}</code>       <span>Current time in UTC (e.g. 04:30 PM UTC)</span>
                    <code>{channel}</code>    <span>Mentions the current channel</span>
                  </div>
                  <p class="bf-hint" style="margin-top:0.5rem">💡 Variables work in: scheduled messages, sticky messages, and command triggers. They are <strong>not</strong> substituted for Template or Webhook delivery.</p>
                </div>
              </div>

            </div><!-- /builder-left -->

            <!-- RIGHT: Discord preview -->
            <div class="builder-right">
              <div class="builder-preview-label">Discord Preview</div>
              <div class="discord-preview-wrap">
                <div class="discord-msg-row">
                  <div class="discord-avatar">F</div>
                  <div class="discord-msg-body">
                    <div class="discord-username-row">
                      <span class="discord-username">FlynnBot</span>
                      <span class="discord-bot-badge">BOT</span>
                      <span class="discord-timestamp" id="previewTimestamp"></span>
                    </div>
                    <div id="previewContent"></div>
                    <div id="previewEmbeds"></div>
                    <div id="previewComponents"></div>
                  </div>
                </div>
              </div>
            </div><!-- /builder-right -->

          </div><!-- /builder-split -->
        </div><!-- /builderEditor -->

        <!-- Empty state (shown when no messages and no editor open) -->
        <div id="builderEmptyState" class="builder-empty-state">
          <div class="builder-empty-icon">📨</div>
          <h3>No messages yet</h3>
          <p>Click <strong>+ New Message</strong> to create your first rich Discord message with embeds, scheduling, or command triggers.</p>
          <button class="btn btn-primary" id="builderNewBtnEmpty">+ New Message</button>
        </div>

      </section>


      <!-- ── ATTACH TO MESSAGE MODAL ── -->
      <div id="attachMsgBackdrop" class="modal-backdrop" aria-hidden="true">
        <div class="modal" role="dialog" aria-modal="true" style="max-width:520px">
          <button class="modal-close" id="attachMsgClose" aria-label="Close">✕</button>
          <h3 style="margin-bottom:1rem">🔗 Attach to Existing Message</h3>
          <p style="font-size:0.83rem;color:var(--text-2);margin-bottom:1.2rem;line-height:1.5">
            Paste a Discord message link below. For <strong>buttons &amp; select menus</strong>, this must be a bot-sent message (the bot will edit it to add components). For <strong>emoji reactions</strong>, this can be any message.
          </p>
          <label class="rr-label" style="margin-bottom:1rem">
            Discord Message URL <span class="required">*</span>
            <input type="url" id="attachMsgUrl" placeholder="https://discord.com/channels/…/…/…" style="font-size:0.85rem" />
          </label>
          <p id="attachMsgStatus" style="font-size:0.82rem;min-height:1.1rem;margin-bottom:0.75rem;color:var(--text-2)"></p>
          <div style="display:flex;gap:0.6rem;justify-content:flex-end">
            <button class="btn btn-secondary" id="attachMsgCancel">Cancel</button>
            <button class="btn btn-primary" id="attachMsgConfirm">🔗 Attach Components</button>
          </div>
        </div>
      </div>

      <!-- ── REACTION ROLES SECTION ── -->
      <section class="dash-section" id="section-reaction-roles" data-section="reaction-roles" style="display:none">
        <div class="section-header">
          <div>
            <h2 class="section-page-title">Reaction Roles</h2>
            <p class="section-page-sub">Create interactive role assignment via buttons, dropdowns, or emoji reactions.</p>
          </div>
          <button class="btn btn-primary" id="rrNewBtn">+ New Group</button>
        </div>
        <div id="rrList">
          <div class="commands-loading"><div class="spinner"></div>Loading…</div>
        </div>

        <div id="rrCreateChoiceBackdrop" class="modal-backdrop" aria-hidden="true">
          <div class="modal" role="dialog" aria-modal="true" style="max-width:540px">
            <button class="modal-close" id="rrCreateChoiceCancel" aria-label="Close">✕</button>
            <h3 style="margin-bottom:0.65rem">Create Reaction Role Group</h3>
            <p style="font-size:0.86rem;color:var(--text-2);line-height:1.45;margin-bottom:1rem">
              Choose how this group should be posted. Existing-message mode is emoji-only.
            </p>
            <div style="display:grid;gap:0.75rem">
              <button class="btn btn-secondary" id="rrCreateChoiceNew" type="button">Create New Bot Message (Buttons/Dropdown/Emoji)</button>
              <button class="btn btn-primary" id="rrCreateChoiceExisting" type="button">Use Existing Message Link (Emoji Only)</button>
            </div>
          </div>
        </div>

        <!-- Reaction Role Editor Modal -->
        <div id="rrEditorBackdrop" class="modal-backdrop" aria-hidden="true">
          <div class="modal rr-editor-modal" role="dialog" aria-modal="true">
            <button class="modal-close" id="rrEditorClose" aria-label="Close">✕</button>
            <h3 id="rrEditorTitle">New Reaction Role Group</h3>
            <p id="rrCreateModeHint" class="rr-hint" style="display:none;margin-top:0.2rem"></p>

            <div class="rr-editor-form">

              <div class="rr-form-row">
                <label class="rr-label">Name <span class="required">*</span>
                  <input type="text" id="rrName" placeholder="e.g. Game Roles" maxlength="60" />
                </label>
                <label class="rr-label">Type <span class="required">*</span>
                  <select id="rrType">
                    <option value="button">Buttons</option>
                    <option value="dropdown">Dropdown Menu</option>
                    <option value="emoji">Emoji Reactions</option>
                  </select>
                </label>
              </div>

              <!-- Button / Dropdown config -->
              <div id="rrBotMessageConfig">
                <div class="rr-form-row">
                  <label class="rr-label">Post to Channel <span class="required">*</span>
                    <select id="rrChannel">
                      <option value="">Select a channel…</option>
                    </select>
                  </label>
                </div>
                <div class="rr-form-row">
                  <label class="rr-label">Embed Title
                    <input type="text" id="rrEmbedTitle" placeholder="Reaction Roles" maxlength="256" />
                  </label>
                </div>
                <div class="rr-form-row">
                  <label class="rr-label">Embed Description
                    <textarea id="rrEmbedDesc" rows="3" placeholder="Click a button or select an option below." maxlength="4096"></textarea>
                  </label>
                </div>
                <div class="rr-form-row">
                  <label class="rr-label">Embed Color
                    <input type="color" id="rrEmbedColor" value="#0f52ba" />
                  </label>
                </div>
              </div>

              <!-- Emoji reaction config -->
              <div id="rrEmojiConfig" style="display:none">
                <div class="rr-form-row">
                  <label class="rr-label">Message URL <span class="required">*</span>
                    <input type="text" id="rrMessageUrl" placeholder="https://discord.com/channels/…/…/…" />
                  </label>
                </div>
                <p class="rr-hint">Paste the Discord message link. Right-click any message → Copy Message Link.</p>
              </div>

              <!-- Options -->
              <div class="rr-options-section">
                <div class="rr-options-header">
                  <strong>Options</strong>
                  <button type="button" class="btn btn-sm" id="rrAddOption">+ Add Option</button>
                </div>
                <div id="rrOptionsList"></div>
              </div>

              <!-- Message preview -->
              <div class="rr-preview-section" id="rrPreviewSection">
                <div class="rr-preview-label">Message Preview</div>
                <div id="rrPreview" class="rr-preview-box">
                  <div class="rr-preview-embed">
                    <div class="rr-preview-bar" id="rrPreviewBar"></div>
                    <div class="rr-preview-body">
                      <div class="rr-preview-title" id="rrPreviewTitle"></div>
                      <div class="rr-preview-desc" id="rrPreviewDesc"></div>
                      <div class="rr-preview-components" id="rrPreviewComponents"></div>
                    </div>
                  </div>
                </div>
              </div>

            </div>

            <div class="rr-editor-actions">
              <button class="btn btn-secondary" id="rrEditorCancel">Cancel</button>
              <button class="btn btn-primary" id="rrEditorSave">Save Draft</button>
              <button class="btn btn-success" id="rrEditorPost">Post to Discord</button>
            </div>
          </div>
        </div>
      </section>

      <!-- ── LEVELING SECTION ── -->
          <section class="dash-section" id="section-levels" data-section="levels" style="display:none">

            <div class="section-header">
              <div>
                <h2 class="section-page-title">Leveling</h2>
                <p class="section-page-sub">Configure XP gain, level-up messages, role rewards, and manage your leaderboard.</p>
              </div>
              <div style="display:flex;align-items:center;gap:0.75rem">
                <span style="font-size:0.9rem;color:var(--text-2)">Leveling system</span>
                <label class="lv-toggle">
                  <input type="checkbox" id="lvEnabled">
                  <span class="lv-toggle-slider"></span>
                </label>
              </div>
            </div>

            <!-- Save bar -->
            <div class="lv-save-bar" id="lvSaveBar" style="display:none">
              <button class="btn btn-primary" id="lvSaveBtn">💾 Save Changes</button>
              <span class="save-status" id="lvSaveStatus"></span>
            </div>

            <div id="lvContent" style="display:none">

              <!-- XP Settings -->
              <div class="lv-card">
                <div class="lv-card-title">⚡ XP Settings</div>
                <div class="lv-form-grid">
                  <label class="lv-label">
                    XP per Message
                    <div style="display:flex;align-items:center;gap:0.5rem">
                      <input type="number" id="lvXpRate" class="lv-input" min="1" max="500" placeholder="15">
                      <span class="lv-hint-inline">1–500</span>
                    </div>
                  </label>
                  <label class="lv-label">
                    Cooldown (seconds)
                    <div style="display:flex;align-items:center;gap:0.5rem">
                      <input type="number" id="lvXpCooldown" class="lv-input" min="0" max="3600" placeholder="60">
                      <span class="lv-hint-inline">0 = no cooldown</span>
                    </div>
                  </label>
                </div>
              </div>

              <!-- XP Channels -->
              <div class="lv-card">
                <div class="lv-card-title">📢 XP Channels</div>
                <p class="lv-hint">Restrict XP gain to specific channels. Leave empty to allow all channels.</p>
                <div id="lvChannelsSelect" class="lv-channel-list"></div>
              </div>

              <!-- Level Up Message -->
              <div class="lv-card">
                <div class="lv-card-title">🎉 Level Up Message</div>
                <div class="lv-form-grid">
                  <label class="lv-label" style="grid-column:1/-1">
                    Message Template
                    <textarea id="lvLevelUpMessage" class="lv-textarea" rows="2" maxlength="500"
                      placeholder="Congrats {user}! You reached level {level} in {server}."></textarea>
                    <span class="lv-hint-inline">Variables: <code>{user}</code> <code>{level}</code> <code>{server}</code></span>
                  </label>
                  <label class="lv-label">
                    Post to Channel
                    <select id="lvLevelUpChannel" class="lv-select">
                      <option value="">Same channel as message</option>
                    </select>
                  </label>
                </div>
              </div>

              <!-- Role Rewards -->
              <div class="lv-card">
                <div class="lv-card-title">🏆 Role Rewards</div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem">
                  <p class="lv-hint" style="margin:0">Assign roles when members reach a level.</p>
                  <div style="display:flex;align-items:center;gap:0.75rem">
                    <label class="lv-label" style="flex-direction:row;align-items:center;gap:0.4rem;margin:0;font-size:0.83rem">
                      <input type="checkbox" id="lvRoleStack"> Stack rewards
                    </label>
                    <button class="btn btn-sm" id="lvAddRewardBtn">+ Add Reward</button>
                  </div>
                </div>
                <div id="lvRewardsList"></div>
                <p id="lvRewardsEmpty" class="lv-hint" style="text-align:center;margin:0">No rewards configured.</p>
              </div>

              <!-- Formula -->
              <div class="lv-card">
                <div class="lv-card-title">📐 XP Formula</div>
                <p class="lv-hint">XP required for next level = <code>a × level² + b × level + c</code></p>
                <div class="lv-form-grid">
                  <label class="lv-label">a <input type="number" id="lvFormulaA" class="lv-input" min="0" step="0.1"></label>
                  <label class="lv-label">b <input type="number" id="lvFormulaB" class="lv-input" min="0" step="0.1"></label>
                  <label class="lv-label">c <input type="number" id="lvFormulaC" class="lv-input" min="1" step="0.1"></label>
                </div>
              </div>

              <!-- Leaderboard -->
              <div class="lv-card">
                <div class="lv-card-title">🏅 Leaderboard</div>
                <div id="lvLeaderboard" class="lv-lb-table-wrap">
                  <div class="commands-loading"><div class="spinner"></div>Loading…</div>
                </div>
                <div style="display:flex;justify-content:center;gap:0.5rem;margin-top:0.75rem" id="lvLbPagination"></div>
              </div>

              <!-- Danger Zone -->
              <div class="lv-card lv-card--danger">
                <div class="lv-card-title" style="color:#f87171">⚠️ Danger Zone</div>
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem">
                  <div>
                    <div style="font-weight:600;margin-bottom:0.25rem">Reset All XP</div>
                    <div class="lv-hint" style="margin:0">Permanently deletes all XP and level data for every member in this server.</div>
                  </div>
                  <button class="btn btn-danger" id="lvResetBtn">🗑️ Reset Leaderboard</button>
                </div>
              </div>

            </div><!-- /lvContent -->

            <!-- Add Reward Modal -->
            <div id="lvRewardBackdrop" class="modal-backdrop" aria-hidden="true">
              <div class="modal" role="dialog" aria-modal="true" style="max-width:420px">
                <button class="modal-close" id="lvRewardClose" aria-label="Close">✕</button>
                <h3 style="margin-bottom:1rem">Add Role Reward</h3>
                <label class="lv-label">Required Level <span class="required">*</span>
                  <input type="number" id="lvRewardLevel" min="1" max="9999" placeholder="e.g. 10">
                </label>
                <label class="lv-label" style="margin-top:0.75rem">Role <span class="required">*</span>
                  <select id="lvRewardRole">
                    <option value="">Select a role…</option>
                  </select>
                </label>
                <div style="display:flex;gap:0.6rem;justify-content:flex-end;margin-top:1.25rem">
                  <button class="btn btn-secondary" id="lvRewardCancel">Cancel</button>
                  <button class="btn btn-primary" id="lvRewardConfirm">Add Reward</button>
                </div>
              </div>
            </div>

          </section>

  <nav class="mobile-bottom-nav" aria-label="Mobile quick navigation">
    <button class="mobile-nav-item" type="button" data-section="home">Home</button>
    <button class="mobile-nav-item" type="button" data-section="commands">Commands</button>
    <button class="mobile-nav-item" type="button" data-section="applications">Apps</button>
    <button class="mobile-nav-item" type="button" data-section="embeds">Messages</button>
    <button class="mobile-nav-item" type="button" data-section="levels">Levels</button>
  </nav>

  <!-- INFO MODAL -->
  <div id="infoModalBackdrop" class="modal-backdrop" aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true">
      <button class="modal-close" id="infoModalClose" aria-label="Close">✕</button>
      <div id="infoModalContent"></div>
    </div>
  </div>

  <!-- SETTINGS PANEL -->
  <div id="settingsBackdrop" class="panel-backdrop" aria-hidden="true"></div>
  <aside id="settingsPanel" class="settings-panel" aria-label="Command settings">
    <div class="settings-panel-header">
      <h3 class="settings-panel-title" id="settingsPanelTitle">Command Settings</h3>
      <button class="modal-close" id="settingsPanelClose" aria-label="Close">✕</button>
    </div>
    <div class="settings-panel-body" id="settingsPanelBody">
      <div class="commands-loading"><div class="spinner"></div></div>
    </div>
  </aside>

  <div id="pageData" data-guild-id="<%= guild.id %>" style="display:none"></div>
  <script src="/js/app.js?v=20260425"></script>
  <script src="/js/server.js?v=20260425"></script>
  <script src="/js/logging.js?v=20260425"></script>
  <script src="/js/builder.js?v=20260425"></script>
  <script src="/js/reactionroles.js?v=20260425"></script>
  <script src="/js/applications.js?v=20260425"></script>
  <script src="/js/leveling.js?v=20260426"></script>
</body>
</html>
