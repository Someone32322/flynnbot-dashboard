  <div id="settingsBackdrop" class="panel-backdrop" aria-hidden="true"></div>
  <aside id="settingsPanel" class="settings-panel" aria-label="Command settings">
    <div class="settings-panel-header">
      <h3 class="settings-panel-title" id="settingsPanelTitle">Command Settings</h3>
      <button class="modal-close" id="settingsPanelClose" aria-label="Close">✕</button>
    </div>
    <div class="settings-panel-body" id="settingsPanelBody">
      <div class="commands-loading"><div class="spinner"></div></div>
    </div>
  </aside>

  <div id="pageData" data-guild-id="<%= guild.id %>" style="display:none"></div>

  <!-- Global Discord-style unsaved changes bar -->
  <div id="globalSaveBar" aria-hidden="true" aria-live="polite">
    <div class="savebar-inner">
      <span class="savebar-msg">
        <span class="savebar-dot"></span>
        Careful — you have unsaved changes!
      </span>
      <div class="savebar-actions">
        <button id="globalSaveBarReset">Reset</button>
        <button id="globalSaveBarSave">Save changes</button>
      </div>
    </div>
  </div>

  <!-- Mobile sidebar toggle — must appear BEFORE the wiring script -->
  <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar" aria-expanded="false">☰</button>

  <script src="/js/custom-select.js?v=20260427"></script>
  <script src="/js/app.js?v=20260425"></script>
  <script src="/js/server.js?v=20260425"></script>
  <script src="/js/logging.js?v=20260506"></script>
  <script src="/js/builder.js?v=20260506"></script>
  <script src="/js/reactionroles.js?v=20260425"></script>
  <script src="/js/applications.js?v=20260425"></script>
  <script src="/js/leveling.js?v=20260506"></script>
  <script src="/js/cases.js?v=20260506"></script>
  <script src="/js/modconfig.js?v=20260501"></script>
  <script src="/js/savebar.js?v=20260506"></script>
  <script src="/js/bot-responses.js?v=20260506"></script>
  <script src="/js/automod.js?v=20260601"></script>
  <script src="/js/welcome.js?v=20260601"></script>
  <script src="/js/tickets.js?v=20260601"></script>

  <!-- ── Modal: Punish type settings ── -->
  <div id="punishTypeModal" class="modal-overlay" style="display:none" role="dialog" aria-modal="true" aria-label="Punish type settings">
    <div class="modal-card modal-card--lg">
      <div class="modal-header">
        <h3 class="modal-title" id="punishTypeModalTitle">Mute settings</h3>
        <button class="modal-close" data-modal="punishTypeModal" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body" id="punishTypeModalBody">
        <!-- filled by JS -->
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost btn-sm" data-modal="punishTypeModal">Cancel</button>
        <button class="btn btn-primary btn-sm" id="punishTypeSave">Save</button>
      </div>
    </div>
  </div>

  <!-- ── Modal: Add appeal question ── -->
  <div id="addAppealQModal" class="modal-overlay" style="display:none" role="dialog" aria-modal="true" aria-label="Add appeal question">
    <div class="modal-card modal-card--md">
      <div class="modal-header">
        <h3 class="modal-title" id="appealQModalTitle">Add question</h3>
        <button class="modal-close" data-modal="addAppealQModal" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body">
        <label class="modal-label">QUESTION LABEL</label>
        <input type="text" id="appealQLabel" class="modal-input" placeholder="e.g. Why do you think this punishment was unfair?">
        <label class="modal-label" style="margin-top:1rem">INPUT TYPE</label>
        <div class="mod-type-tabs" id="appealQTypeTabs">
          <button class="mod-type-tab active" data-type="textarea">Long text</button>
          <button class="mod-type-tab" data-type="text">Short text</button>
        </div>
        <div style="margin-top:1rem;display:flex;align-items:center;gap:0.75rem">
          <label class="toggle-switch">
            <input type="checkbox" id="appealQRequired">
            <span class="toggle-slider"></span>
          </label>
          <span style="font-size:0.85rem;color:var(--text-2)">Required</span>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost btn-sm" data-modal="addAppealQModal">Cancel</button>
        <button class="btn btn-primary btn-sm" id="addAppealQSave">Add question</button>
      </div>
    </div>
  </div>

  <!-- ── Modal: User reports setup wizard ── -->
  <div id="userReportsWizardModal" class="modal-overlay" style="display:none" role="dialog" aria-modal="true" aria-label="Set up user reports">
    <div class="modal-card modal-card--md" id="urWizardCard">
      <!-- Step 0: intro -->
      <div class="ur-wizard-step" data-step="0">
        <div class="modal-header">
          <h3 class="modal-title">Set up User reports</h3>
          <button class="modal-close" data-modal="userReportsWizardModal" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
          <div class="ur-wizard-intro-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>
          </div>
          <p class="ur-wizard-intro-text">User reports allow your server members to report each other directly through Discord. Reports are sent to a channel of your choice where moderators can review and take action.</p>
          <p class="ur-wizard-intro-hint">This quick setup wizard will guide you through configuring ways to report, predefined reasons, the report channel, and ping roles.</p>
        </div>
        <div class="modal-footer">
          <button class="btn btn-ghost btn-sm" data-modal="userReportsWizardModal">Cancel</button>
          <button class="btn btn-primary btn-sm" id="urWizardStart">Start setup →</button>
        </div>
      </div>
      <!-- Step 1: ways to report -->
      <div class="ur-wizard-step" data-step="1" style="display:none">
        <div class="modal-header">
          <span class="modal-step-pill">1 / 4</span>
          <h3 class="modal-title">Ways to report</h3>
          <button class="modal-close" data-modal="userReportsWizardModal" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
          <p class="modal-hint">Select the ways users can report others. You can rename each method below.</p>
          <div class="ur-way-row">
            <label class="toggle-switch"><input type="checkbox" id="urWaySlash"><span class="toggle-slider"></span></label>
            <div class="ur-way-info">
              <span class="ur-way-label">Slash command</span>
              <input type="text" class="ur-way-name-input" id="urWaySlashName" placeholder="report" value="report">
            </div>
          </div>
          <div class="ur-way-row">
            <label class="toggle-switch"><input type="checkbox" id="urWayUserCtx"><span class="toggle-slider"></span></label>
            <div class="ur-way-info">
              <span class="ur-way-label">User context menu</span>
              <input type="text" class="ur-way-name-input" id="urWayUserCtxName" placeholder="Report user" value="Report user">
            </div>
          </div>
          <div class="ur-way-row">
            <label class="toggle-switch"><input type="checkbox" id="urWayMsgCtx"><span class="toggle-slider"></span></label>
            <div class="ur-way-info">
              <span class="ur-way-label">Message context menu</span>
              <input type="text" class="ur-way-name-input" id="urWayMsgCtxName" placeholder="Report message" value="Report message">
            </div>
          </div>
          <div class="ur-way-row">
            <label class="toggle-switch"><input type="checkbox" id="urWayReaction"><span class="toggle-slider"></span></label>
            <div class="ur-way-info">
              <span class="ur-way-label">Message reactions</span>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-ghost btn-sm ur-wizard-prev">← Back</button>
          <button class="btn btn-primary btn-sm ur-wizard-next">Next →</button>
        </div>
      </div>
      <!-- Step 2: predefined reasons -->
      <div class="ur-wizard-step" data-step="2" style="display:none">
        <div class="modal-header">
          <span class="modal-step-pill">2 / 4</span>
          <h3 class="modal-title">Predefined report reasons</h3>
          <button class="modal-close" data-modal="userReportsWizardModal" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
            <label class="toggle-switch"><input type="checkbox" id="urAllowCustomReason" checked><span class="toggle-slider"></span></label>
            <span style="font-size:0.85rem;color:var(--text-2)">Allow custom reason</span>
          </div>
          <div id="urReasonsList" class="ur-reasons-list"></div>
          <button class="btn btn-ghost btn-sm" id="urAddReason" style="margin-top:0.5rem">+ Add reason</button>
        </div>
        <div class="modal-footer">
          <button class="btn btn-ghost btn-sm ur-wizard-prev">← Back</button>
          <button class="btn btn-primary btn-sm ur-wizard-next">Next →</button>
        </div>
      </div>
      <!-- Step 3: report channel -->
      <div class="ur-wizard-step" data-step="3" style="display:none">
        <div class="modal-header">
          <span class="modal-step-pill">3 / 4</span>
          <h3 class="modal-title">Report channel</h3>
          <button class="modal-close" data-modal="userReportsWizardModal" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
          <p class="modal-hint">Select the channel where reports will be sent to your moderation team.</p>
          <div id="urChannelPickerWrap" class="mod-channel-picker-wrap"></div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-ghost btn-sm ur-wizard-prev">← Back</button>
          <button class="btn btn-primary btn-sm ur-wizard-next">Next →</button>
        </div>
      </div>
      <!-- Step 4: ping roles -->
      <div class="ur-wizard-step" data-step="4" style="display:none">
        <div class="modal-header">
          <span class="modal-step-pill">4 / 4</span>
          <h3 class="modal-title">Ping roles</h3>
          <button class="modal-close" data-modal="userReportsWizardModal" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
          <p class="modal-hint">Select roles to be pinged when a new report is submitted. Leave empty to not ping anyone.</p>
          <div id="urPingRolesWrap" class="mod-role-picker-wrap"></div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-ghost btn-sm ur-wizard-prev">← Back</button>
          <button class="btn btn-primary btn-sm" id="urWizardFinish">Finish setup ✓</button>
        </div>
      </div>
    </div>
  </div>

</body>
</html>
