<%- include('partials/head', { title: 'Home' }) %>
<body>
  <%- include('partials/nav') %>

  <section class="landing-hero" id="home">
    <div class="landing-backdrop"></div>
    <div class="landing-hero-shell">
      <div class="landing-left">
        <div class="landing-brand-row">
          <img src="/images/flynn.png" alt="Flynn logo" class="landing-brand-icon landing-brand-icon-image">
          <h1 class="landing-title">Flynn</h1>
        </div>

        <p class="landing-line">Multi-purpose Discord Bot.</p>
        <p class="landing-line">Fully customizable.</p>
        <p class="landing-line">Completely free.</p>

        <div class="landing-cta-row">
          <a
            href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot+applications.commands"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg"
          >
            Add to Discord
          </a>
          <a href="#about" class="btn btn-ghost btn-lg">Explore features</a>
        </div>
      </div>

      <div class="landing-right" aria-hidden="true">
        <div class="hex-cluster">
          <span class="hex hex-lg h1"></span>
          <span class="hex hex-md h2"></span>
          <span class="hex hex-md h3"></span>
          <span class="hex hex-sm h4"></span>
          <span class="hex hex-xs h5"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="features" id="about">
    <div class="features-header">
      <span class="section-label animate-in">About</span>
      <h2 class="section-title animate-in">Built for modern communities</h2>
      <p class="section-subtitle animate-in">A polished moderation and engagement stack with clean UX and reliable automation.</p>
    </div>

    <div class="features-grid">
      <div class="feature-card animate-in">
        <div class="feature-icon">🛡️</div>
        <h3>Advanced Moderation</h3>
        <p>Ban, kick, warn, timeout, and voice moderation with full case history.</p>
      </div>
      <div class="feature-card animate-in">
        <div class="feature-icon">⭐</div>
        <h3>Leveling System</h3>
        <p>Dashboard-first XP controls, role rewards, rank cards, and leaderboards.</p>
      </div>
      <div class="feature-card animate-in">
        <div class="feature-icon">📋</div>
        <h3>Audit Logging</h3>
        <p>Track moderation and server actions with clean, configurable logging streams.</p>
      </div>
      <div class="feature-card animate-in">
        <div class="feature-icon">🎨</div>
        <h3>Custom Messages</h3>
        <p>Build rich embeds, interactive messages, and reaction-role experiences.</p>
      </div>
    </div>
  </section>

  <section class="landing-status" id="status">
    <div class="status-card">
      <h3>Service Status</h3>
      <p>Operational. Core bot systems and dashboard endpoints are online.</p>
    </div>
    <div class="status-card" id="branding">
      <h3>Custom Branding</h3>
      <p>Theme your server experience with consistent FLYNNCOLOUR-style visuals and message templates.</p>
    </div>
  </section>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
