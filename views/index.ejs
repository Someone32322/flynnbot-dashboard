<%- include('partials/head', { title: 'Home' }) %>
<body>
  <%- include('partials/nav') %>

  <!-- ── HERO ── -->
  <section class="hero">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="hero-grid"></div>
      <div class="hero-fade"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Free &amp; open for all servers
      </div>
      <div class="home-hero-logo">
        <img src="/images/flynn.png" alt="Flynn" class="home-hero-logo-img">
      </div>
      <h1 class="hero-title"><span class="gradient-text">FlynnBot</span></h1>
      <p class="hero-subtitle">A powerful Discord bot for moderation, leveling, logging, and more. Everything your server needs, in one place.</p>
      <div class="hero-actions">
        <a
          href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot+applications.commands"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.014.044.031.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.995a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
          Add to Discord
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="/api/auth/login" class="btn btn-ghost btn-lg">
          Open Dashboard
        </a>
      </div>
    </div>
  </section>

  <!-- ── FEATURES ── -->
  <section class="features">
    <div class="features-header">
      <span class="section-label">What Flynn can do</span>
      <h2 class="section-title">Everything your server needs.</h2>
      <p class="section-subtitle">From moderation tools to engagement features, FlynnBot handles it all without the complexity.</p>
    </div>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">&#x1F6E1;&#xFE0F;</div>
        <h3>Moderation</h3>
        <p>Ban, kick, mute, and warn members with a full case management system. Predefined reasons, immune roles, and DM notifications included.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x1F4C8;</div>
        <h3>Leveling</h3>
        <p>Reward active members with XP, level-up messages, and automatic role rewards. Manage your server leaderboard from the dashboard.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x1F4CB;</div>
        <h3>Logging</h3>
        <p>Track message edits, deletes, member joins, bans, and more. Route each event type to its own dedicated channel.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x1F3AD;</div>
        <h3>Reaction Roles</h3>
        <p>Let members self-assign roles using buttons, dropdowns, or emoji. Fine-tune access rules for every role group.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x26A1;</div>
        <h3>Custom Commands</h3>
        <p>Build slash commands with custom responses, role restrictions, and channel allowlists — no coding required.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x1F4E8;</div>
        <h3>Message Builder</h3>
        <p>Design rich embeds, schedule announcements, and add interactive components. Preview everything live before sending.</p>
      </div>
    </div>
  </section>

  <!-- ── STATS STRIP ── -->
  <div class="home-stats-strip">
    <div class="home-stats-inner">
      <div class="home-stat">
        <span class="home-stat-value">10+</span>
        <span class="home-stat-label">Feature Modules</span>
      </div>
      <div class="home-stat-divider"></div>
      <div class="home-stat">
        <span class="home-stat-value">Free</span>
        <span class="home-stat-label">No paywalls, ever</span>
      </div>
      <div class="home-stat-divider"></div>
      <div class="home-stat">
        <span class="home-stat-value">24/7</span>
        <span class="home-stat-label">Always online</span>
      </div>
      <div class="home-stat-divider"></div>
      <div class="home-stat">
        <span class="home-stat-value">Web</span>
        <span class="home-stat-label">Dashboard included</span>
      </div>
    </div>
  </div>

  <!-- ── CTA ── -->
  <section class="home-cta">
    <div class="home-cta-inner">
      <h2 class="home-cta-title">Ready to upgrade your server?</h2>
      <p class="home-cta-sub">Add FlynnBot in seconds and configure everything from the dashboard.</p>
      <div class="home-cta-actions">
        <a
          href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot+applications.commands"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.014.044.031.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.995a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
          Add to Discord
        </a>
        <a href="/status" class="btn btn-ghost btn-lg">View Status</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
