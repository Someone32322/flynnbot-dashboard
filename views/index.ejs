<%- include('partials/head', { title: 'Home' }) %>
<body>
  <%- include('partials/nav') %>

  <!-- ====== HERO ====== -->
  <section class="hero">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="hero-grid"></div>
      <div class="hero-fade"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Advanced Discord Bot
      </div>

      <h1 class="hero-title">
        <span class="gradient-text">Powerful moderation</span><br>
        for your community.
      </h1>

      <p class="hero-subtitle">
        FlynnBot delivers professional-grade moderation tools, full case management,
        and detailed audit logging — all in one seamless package.
      </p>

      <div class="hero-actions">
        <a
          href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot+applications.commands"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg"
        >
          <span class="btn-icon">+</span> Add to Discord
        </a>
        <a href="<%= user ? '/dashboard' : '/api/auth/login' %>" class="btn btn-ghost btn-lg">
          Dashboard <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ====== FEATURES ====== -->
  <section class="features">
    <div class="features-header">
      <span class="section-label animate-in">Features</span>
      <h2 class="section-title animate-in">Everything your server needs</h2>
      <p class="section-subtitle animate-in">
        Comprehensive tools built for community managers who demand the best.
      </p>
    </div>

    <div class="features-grid">
      <div class="feature-card animate-in">
        <div class="feature-icon">🛡️</div>
        <h3>Advanced Moderation</h3>
        <p>Ban, kick, warn, timeout, and mute members with detailed case tracking and full audit trails.</p>
      </div>
      <div class="feature-card animate-in">
        <div class="feature-icon">📋</div>
        <h3>Case Management</h3>
        <p>Every action generates a unique case ID with full history, editable reasons, and timestamps.</p>
      </div>
      <div class="feature-card animate-in">
        <div class="feature-icon">📊</div>
        <h3>Audit Logging</h3>
        <p>Detailed logs with moderator attribution, target information, and formatted embeds for every action.</p>
      </div>
      <div class="feature-card animate-in">
        <div class="feature-icon">📨</div>
        <h3>DM Notifications</h3>
        <p>Keep users informed with professional direct message notifications for all moderation actions.</p>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
