<%- include('partials/head', { title: 'Home' }) %>
<body>
  <%- include('partials/nav') %>

  <!-- ░░ HERO ░░ -->
  <section class="lp-hero" id="home">
    <!-- Background layers -->
    <div class="lp-hero-bg">
      <div class="lp-orb lp-orb-1"></div>
      <div class="lp-orb lp-orb-2"></div>
      <div class="lp-orb lp-orb-3"></div>
      <div class="lp-grid"></div>
      <div class="lp-noise"></div>
    </div>

    <div class="lp-hero-inner">
      <!-- Left copy -->
      <div class="lp-copy">
        <div class="lp-badge">
          <span class="lp-badge-dot"></span>
          Completely free &amp; open source
        </div>

        <h1 class="lp-title">
          The Discord bot<br>
          <span class="lp-title-gradient">built for you</span>
        </h1>

        <p class="lp-desc">
          Moderation, leveling, logging, embeds, reaction roles and more — 
          all managed from a polished dashboard.
        </p>

        <div class="lp-cta-row">
          <a
            href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot+applications.commands"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg lp-btn-add"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.014.044.031.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.995a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
            Add to Discord
          </a>
          <a href="#features" class="btn btn-ghost btn-lg lp-btn-explore">
            See features
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="lp-stats-row">
          <div class="lp-stat">
            <span class="lp-stat-num">6+</span>
            <span class="lp-stat-label">Feature modules</span>
          </div>
          <div class="lp-stat-divider"></div>
          <div class="lp-stat">
            <span class="lp-stat-num">100%</span>
            <span class="lp-stat-label">Free forever</span>
          </div>
          <div class="lp-stat-divider"></div>
          <div class="lp-stat">
            <span class="lp-stat-num">24/7</span>
            <span class="lp-stat-label">Always online</span>
          </div>
        </div>
      </div>

      <!-- Right visual -->
      <div class="lp-visual" aria-hidden="true">
        <div class="lp-card-mock lp-card-main">
          <div class="lp-card-header">
            <div class="lp-card-dots">
              <span></span><span></span><span></span>
            </div>
            <span class="lp-card-title-label">Dashboard Preview</span>
          </div>
          <div class="lp-card-body">
            <div class="lp-mock-row">
              <div class="lp-mock-icon lp-mock-icon-blue">🛡️</div>
              <div class="lp-mock-lines">
                <div class="lp-mock-line lp-mock-line-w80"></div>
                <div class="lp-mock-line lp-mock-line-w50 lp-mock-line-dim"></div>
              </div>
              <div class="lp-mock-badge lp-mock-badge-green">Active</div>
            </div>
            <div class="lp-mock-row">
              <div class="lp-mock-icon lp-mock-icon-yellow">⭐</div>
              <div class="lp-mock-lines">
                <div class="lp-mock-line lp-mock-line-w70"></div>
                <div class="lp-mock-line lp-mock-line-w40 lp-mock-line-dim"></div>
              </div>
              <div class="lp-mock-badge lp-mock-badge-blue">Config</div>
            </div>
            <div class="lp-mock-row">
              <div class="lp-mock-icon lp-mock-icon-purple">📋</div>
              <div class="lp-mock-lines">
                <div class="lp-mock-line lp-mock-line-w60"></div>
                <div class="lp-mock-line lp-mock-line-w45 lp-mock-line-dim"></div>
              </div>
              <div class="lp-mock-badge lp-mock-badge-green">Active</div>
            </div>
            <div class="lp-mock-divider"></div>
            <div class="lp-mock-stat-row">
              <div class="lp-mock-stat">
                <div class="lp-mock-stat-num">1,248</div>
                <div class="lp-mock-stat-label">Members</div>
              </div>
              <div class="lp-mock-stat">
                <div class="lp-mock-stat-num">84</div>
                <div class="lp-mock-stat-label">Cases</div>
              </div>
              <div class="lp-mock-stat">
                <div class="lp-mock-stat-num">12</div>
                <div class="lp-mock-stat-label">Roles</div>
              </div>
            </div>
          </div>
        </div>
        <!-- Floating accent cards -->
        <div class="lp-card-float lp-card-float-1">
          <span>⚡</span> Bot online
        </div>
        <div class="lp-card-float lp-card-float-2">
          <span>🎉</span> Level up!
        </div>
        <div class="lp-hex-cluster">
          <span class="lp-hex lp-hex-lg"></span>
          <span class="lp-hex lp-hex-md lp-hex-delay1"></span>
          <span class="lp-hex lp-hex-sm lp-hex-delay2"></span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="lp-scroll-hint">
      <div class="lp-scroll-mouse"><div class="lp-scroll-wheel"></div></div>
    </div>
  </section>

  <!-- ░░ FEATURES ░░ -->
  <section class="lp-features" id="features">
    <div class="lp-features-inner">
      <div class="lp-section-head">
        <span class="lp-section-eyebrow">What's included</span>
        <h2 class="lp-section-title">Built for modern communities</h2>
        <p class="lp-section-subtitle">A complete Discord automation stack with every tool you need.</p>
      </div>

      <div class="lp-features-grid">
        <div class="lp-feat-card lp-feat-card-wide">
          <div class="lp-feat-icon lp-feat-icon-red">🛡️</div>
          <div>
            <h3 class="lp-feat-title">Advanced Moderation</h3>
            <p class="lp-feat-desc">Ban, kick, warn, timeout, and voice moderation with full case history and staff accountability logs.</p>
          </div>
          <div class="lp-feat-glow lp-feat-glow-red"></div>
        </div>

        <div class="lp-feat-card">
          <div class="lp-feat-icon lp-feat-icon-yellow">⭐</div>
          <h3 class="lp-feat-title">Leveling System</h3>
          <p class="lp-feat-desc">XP controls, role rewards, rank cards, and full leaderboards.</p>
          <div class="lp-feat-glow lp-feat-glow-yellow"></div>
        </div>

        <div class="lp-feat-card">
          <div class="lp-feat-icon lp-feat-icon-blue">📋</div>
          <h3 class="lp-feat-title">Audit Logging</h3>
          <p class="lp-feat-desc">Track every moderation action with configurable logging streams.</p>
          <div class="lp-feat-glow lp-feat-glow-blue"></div>
        </div>

        <div class="lp-feat-card">
          <div class="lp-feat-icon lp-feat-icon-purple">🎨</div>
          <h3 class="lp-feat-title">Custom Messages</h3>
          <p class="lp-feat-desc">Rich embed builder with reaction roles and interactive messages.</p>
          <div class="lp-feat-glow lp-feat-glow-purple"></div>
        </div>

        <div class="lp-feat-card">
          <div class="lp-feat-icon lp-feat-icon-cyan">📝</div>
          <h3 class="lp-feat-title">Applications</h3>
          <p class="lp-feat-desc">Custom application forms with DM notifications and review workflow.</p>
          <div class="lp-feat-glow lp-feat-glow-cyan"></div>
        </div>

        <div class="lp-feat-card lp-feat-card-cta">
          <h3 class="lp-feat-title">Ready to start?</h3>
          <p class="lp-feat-desc">Add Flynn to your server and configure everything from the dashboard.</p>
          <a
            href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot+applications.commands"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >Add to Discord</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ STATUS + SOCIAL PROOF ░░ -->
  <section class="lp-status-section" id="status">
    <div class="lp-status-inner">
      <div class="lp-status-card">
        <div class="lp-status-indicator">
          <span class="lp-status-dot"></span>
          All systems operational
        </div>
        <h3>Service Status</h3>
        <p>Core bot systems and dashboard endpoints are online and running smoothly.</p>
      </div>
      <div class="lp-status-card">
        <div class="lp-status-indicator lp-status-indicator-accent">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
          Fully customizable
        </div>
        <h3>Custom Branding</h3>
        <p>Theme your server with consistent style visuals, embed templates, and message branding.</p>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
