<%- include('partials/head', { title: 'Dashboard' }) %>
<body>
  <%- include('partials/nav') %>

  <div class="page">
    <div class="page-header">
      <% if (user) { %>
        <%
          const avatarUrl = user.avatar
            ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=64`
            : `https://cdn.discordapp.com/embed/avatars/0.png`;
        %>
        <div class="page-welcome">
          <img src="<%= avatarUrl %>" alt="" class="page-welcome-avatar">
          <div>
            <h1 class="page-title">Welcome back, <%= user.username %></h1>
            <p class="page-subtitle">Select a server to configure. Showing servers where you have Administrator access.</p>
          </div>
        </div>
      <% } else { %>
        <h1 class="page-title">Your Servers</h1>
        <p class="page-subtitle">Select a server you have administrator access to configure.</p>
      <% } %>
    </div>

    <div class="servers-container">
      <% if (guilds.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">🔍</div>
          <h3>No servers found</h3>
          <p>You don't have administrator access in any servers. Try adding FlynnBot to your server first.</p>
          <a
            href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot+applications.commands"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <span>+</span> Add to Discord
          </a>
        </div>
      <% } else { %>
        <div class="servers-grid">
          <% guilds.forEach((guild, i) => {
            const iconUrl = guild.icon
              ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.${guild.icon.startsWith('a_') ? 'gif' : 'png'}?size=128`
              : null;
          %>
            <a href="/dashboard/<%= guild.id %>" class="server-card" data-index="<%= i %>">
              <% if (iconUrl) { %>
                <img src="<%= iconUrl %>" alt="<%= guild.name %>" class="server-icon" loading="lazy">
              <% } else { %>
                <img src="/images/flynn.png" alt="Flynn default icon" class="server-icon server-icon-default" loading="lazy">
              <% } %>
              <div class="server-card-info">
                <div class="server-name"><%= guild.name %></div>
                <div class="server-configure">Configure <span class="configure-arrow">→</span></div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

    <% if (user && user.id === '1192421681751412746') { %>
    <div style="margin-top:1.5rem;text-align:center">
      <a href="/dashboard/owner" class="btn btn-secondary" style="font-size:0.82rem;gap:0.4rem">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Owner Panel
      </a>
    </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
