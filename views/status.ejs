<%- include('partials/head', { title: 'Status' }) %>
<body>
<%- include('partials/nav') %>

<%
  const s = status;
  function formatUptimeSsr(sec) {
    if (!sec) return '—';
    const d = Math.floor(sec / 86400);
    const h = Math.floor((sec % 86400) / 3600);
    const m = Math.floor((sec % 3600) / 60);
    if (d > 0) return `${d}d ${h}h`;
    if (h > 0) return `${h}h ${m}m`;
    return `${m}m`;
  }
  const cssMap   = { online: 'operational', degraded: 'degraded', offline: 'outage' };
  const labelMap = { online: 'All Systems Operational', degraded: 'Degraded Performance', offline: 'Service Disruption' };
  const csCls    = cssMap[s.status]   || 'outage';
  const csLabel  = labelMap[s.status] || 'Unknown';
%>

<div class="status-page" id="status-page"
  data-status="<%= s.status %>"
  data-status-message="<%- encodeURIComponent(s.statusMessage || '') %>"
  data-latency-ms="<%= s.latencyMs !== null ? s.latencyMs : '' %>"
  data-uptime-seconds="<%= s.uptimeSeconds !== null ? s.uptimeSeconds : '' %>"
  data-guild-count="<%= s.guildCount !== null ? s.guildCount : '' %>"
  data-memory-mb="<%= s.memoryMB !== null ? s.memoryMB : '' %>"
  data-high-latency="<%= s.highLatency ? 'true' : 'false' %>"
  data-updated-at="<%= s.updatedAt ? new Date(s.updatedAt).toISOString() : '' %>"
  data-last-heartbeat="<%= s.lastHeartbeat ? new Date(s.lastHeartbeat).toISOString() : '' %>">

  <!-- ── HERO ── -->
  <section class="status-hero">
    <div class="status-hero-copy">
      <p class="status-eyebrow">Service Health</p>
      <h1 class="status-headline gradient-text">FlynnBot Status</h1>
      <p id="status-message" style="font-size:0.9rem;color:var(--text-3);margin-top:6px;line-height:1.6"><%= s.statusMessage %></p>
      <p class="status-time">
        Last heartbeat: <strong id="status-heartbeat" style="color:var(--text-2)"><%= s.lastHeartbeat ? new Date(s.lastHeartbeat).toUTCString() : 'No heartbeat yet' %></strong>
      </p>
    </div>
    <div class="status-hero-panel">
      <div class="overall-status-badge <%= csCls %>" id="status-badge">
        <span class="overall-status-dot"></span>
        <span id="status-label"><%= csLabel %></span>
      </div>
      <span class="live-badge">
        <span class="live-dot"></span>
        LIVE &mdash; refreshes every 15s
      </span>
    </div>
  </section>

  <!-- ── METRICS ── -->
  <div class="status-metrics" id="status-metrics">
    <div class="metric-card metric-info">
      <div class="metric-label">Latency</div>
      <div class="metric-value" id="metric-latency"><%= s.latencyMs !== null ? s.latencyMs : '—' %><% if (s.latencyMs !== null) { %><span style="font-size:1rem;font-weight:600;color:var(--text-3)"> ms</span><% } %></div>
      <div class="metric-unit">Discord API ping</div>
    </div>
    <div class="metric-card metric-info">
      <div class="metric-label">Uptime</div>
      <div class="metric-value good" id="metric-uptime"><%= s.uptimeSeconds !== null ? formatUptimeSsr(s.uptimeSeconds) : '—' %></div>
      <div class="metric-unit">Since last restart</div>
    </div>
    <div class="metric-card metric-info">
      <div class="metric-label">Servers</div>
      <div class="metric-value" id="metric-guilds"><%= s.guildCount !== null ? Number(s.guildCount).toLocaleString() : '—' %></div>
      <div class="metric-unit">Active guilds</div>
    </div>
    <div class="metric-card metric-info">
      <div class="metric-label">Memory</div>
      <div class="metric-value" id="metric-memory"><%= s.memoryMB !== null ? s.memoryMB : '—' %><% if (s.memoryMB !== null) { %><span style="font-size:1rem;font-weight:600;color:var(--text-3)"> ms</span><% } %></div>
      <div class="metric-unit">Process RSS</div>
    </div>
  </div>

  <!-- ── COMPONENTS ── -->
  <div class="status-section">
    <p class="status-section-title">Components</p>
    <div class="component-list">
      <div class="component-item">
        <span class="component-indicator ci-<%= csCls %>" id="comp-bot-dot"></span>
        <span class="component-name">Discord Bot (Flynn)</span>
        <span class="component-status cs-<%= csCls %>" id="comp-bot"><%= csLabel %></span>
        <span class="component-latency" id="comp-bot-latency"><%= s.latencyMs !== null ? s.latencyMs + ' ms' : '—' %></span>
      </div>
      <div class="component-item">
        <span class="component-indicator ci-operational"></span>
        <span class="component-name">Web Dashboard</span>
        <span class="component-status cs-operational" id="comp-dashboard">Operational</span>
        <span class="component-latency">—</span>
      </div>
      <div class="component-item">
        <span class="component-indicator ci-operational"></span>
        <span class="component-name">Database</span>
        <span class="component-status cs-operational">Operational</span>
        <span class="component-latency">—</span>
      </div>
    </div>
  </div>

  <!-- ── UPTIME TIMELINE ── -->
  <div class="status-section">
    <p class="status-section-title">30-Day Uptime History</p>
    <p style="font-size:0.78rem;color:var(--text-4);margin-bottom:14px">
      Each bar represents one calendar day. Live status updates every 15 seconds.
      Hover to see status details.
    </p>
    <div class="uptime-bar-wrap">
      <div class="uptime-bar-label">
        <span>30 days ago</span>
        <span>Today</span>
      </div>
      <div class="uptime-bar" id="status-history"></div>
    </div>
    <div class="uptime-legend">
      <span class="uptime-legend-item">
        <span class="uptime-legend-dot" style="background:linear-gradient(180deg,#4ade80,#16a34a)"></span>
        Operational
      </span>
      <span class="uptime-legend-item">
        <span class="uptime-legend-dot" style="background:linear-gradient(180deg,#fbbf24,#d97706)"></span>
        Degraded
      </span>
      <span class="uptime-legend-item">
        <span class="uptime-legend-dot" style="background:linear-gradient(180deg,#f87171,#dc2626)"></span>
        Outage
      </span>
      <span class="uptime-legend-item">
        <span class="uptime-legend-dot" style="background:linear-gradient(180deg,#818cf8,#4f46e5)"></span>
        Maintenance
      </span>
      <span class="uptime-legend-item">
        <span class="uptime-legend-dot" style="background:rgba(255,255,255,0.08);border:1px dashed rgba(255,255,255,0.2)"></span>
        No data
      </span>
    </div>
  </div>

  <!-- ── INCIDENTS ── -->
  <div class="status-section">
    <p class="status-section-title">Incident History</p>
    <div class="no-incidents">
      <div class="no-incidents-icon">✅</div>
      <h4>No recent incidents</h4>
      <p>All systems have been running smoothly.</p>
    </div>
  </div>

  <p class="status-footer-note">
    Last data fetch: <span id="status-last-updated-time"><%= s.updatedAt ? new Date(s.updatedAt).toUTCString() : 'Never' %></span><br>
    FlynnBot telemetry is collected automatically and updated every 15 seconds.
  </p>

</div><!-- /.status-page -->

<%- include('partials/footer') %>

<script src="/js/status-page.js"></script>
</body>
</html>
