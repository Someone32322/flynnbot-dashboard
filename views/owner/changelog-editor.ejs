<%
  const ownerAvatarUrl = user && user.avatar
    ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=64`
    : `https://cdn.discordapp.com/embed/avatars/0.png`;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Changelog Editor — FlynnBot Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/owner.css">
  <style>
    .cl-editor-wrap {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .cl-notice {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
    }
    .cl-notice--success {
      background: rgba(23, 201, 100, 0.12);
      border: 1px solid rgba(23, 201, 100, 0.3);
      color: #17c964;
    }
    .cl-notice--error {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #f87171;
    }
    .cl-textarea {
      width: 100%;
      min-height: 520px;
      background: rgba(0,0,0,0.25);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      color: #e2e8f0;
      font-family: 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
      font-size: 0.82rem;
      line-height: 1.7;
      padding: 18px;
      resize: vertical;
      box-sizing: border-box;
      outline: none;
      transition: border-color 0.2s;
    }
    .cl-textarea:focus {
      border-color: rgba(99, 102, 241, 0.6);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
    }
    .cl-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .cl-hint {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.35);
      margin-left: auto;
    }
    .cl-schema {
      background: rgba(0,0,0,0.2);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 10px;
      padding: 20px;
    }
    .cl-schema h4 {
      font-size: 0.8rem;
      font-weight: 600;
      color: rgba(255,255,255,0.5);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin: 0 0 14px;
    }
    .cl-schema pre {
      font-family: 'Fira Code', 'Consolas', monospace;
      font-size: 0.78rem;
      color: #94a3b8;
      margin: 0;
      white-space: pre-wrap;
      line-height: 1.6;
    }
  </style>
</head>
<body class="op-body">

<header class="op-topbar">
  <a class="op-topbar-brand" href="/dashboard/owner">
    <div class="op-brand-icon">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    <div>
      <div class="op-brand-text">Flynn Admin</div>
      <div class="op-brand-sub">Owner Panel</div>
    </div>
  </a>
  <div class="op-topbar-right">
    <div class="op-profile-btn">
      <img src="<%= ownerAvatarUrl %>" alt="<%= user.username %>" class="op-profile-avatar">
      <span class="op-profile-name"><%= user.username %></span>
    </div>
  </div>
</header>

<div class="op-shell">
  <aside class="op-sidebar">
    <nav class="op-nav">
      <div class="op-nav-group">
        <span class="op-nav-label">Core</span>
        <a class="op-nav-item" href="/dashboard/owner">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Overview
        </a>
        <a class="op-nav-item op-nav-item--active" href="/owner/changelog">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          Changelog
        </a>
      </div>
    </nav>
    <div class="op-sidebar-footer">
      <a href="/dashboard" class="op-sidebar-back">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Dashboard
      </a>
    </div>
  </aside>

  <main class="op-main">
    <div class="op-panel op-panel--active">
      <div class="op-ph">
        <div>
          <h1 class="op-ph-title">Changelog Editor</h1>
          <p class="op-ph-desc">Edit the public changelog JSON. Changes are reflected at <a href="/changelog" target="_blank" style="color:#4f8ef7">/changelog</a> immediately.</p>
        </div>
        <div class="op-ph-actions">
          <a href="/changelog" target="_blank" class="op-btn op-btn--ghost">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            View Public Page
          </a>
        </div>
      </div>

      <div class="cl-editor-wrap">

        <% if (saved) { %>
          <div class="cl-notice cl-notice--success">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Changelog saved successfully. The public page has been updated.
          </div>
        <% } %>

        <% if (parseError) { %>
          <div class="cl-notice cl-notice--error">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Invalid JSON. Please fix the syntax errors and try again.
          </div>
        <% } %>

        <form method="POST" action="/owner/changelog" id="changelogForm">
          <textarea
            class="cl-textarea"
            name="changelogJson"
            id="changelogJson"
            spellcheck="false"
            autocomplete="off"
          ><%= changelogJson %></textarea>

          <div class="cl-actions" style="margin-top: 12px;">
            <button type="submit" class="op-btn op-btn--primary">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Save Changelog
            </button>
            <button type="button" class="op-btn op-btn--ghost" id="formatBtn">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
              Format JSON
            </button>
            <span class="cl-hint">Ctrl+S to save</span>
          </div>
        </form>

        <div class="cl-schema">
          <h4>JSON Schema Reference</h4>
          <pre>{
  "changelog": [
    {
      "id": "v2.5.0",
      "version": "2.5.0",
      "releaseDate": "2026-05-10",
      "type": "major",
      "title": "Release title",
      "description": "Short summary shown under the title.",
      "features": [
        {
          "category": "New",
          "items": ["Feature description", "Another feature"]
        },
        {
          "category": "Improved",
          "items": ["Something improved"]
        },
        {
          "category": "Fixed",
          "items": ["Bug fixed"]
        }
      ],
      "breaking": false
    }
  ]
}</pre>
        </div>

      </div>
    </div>
  </main>
</div>

<script src="/js/owner-changelog.js"></script>
</body>
</html>

