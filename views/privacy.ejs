    <div class="legal-layout">
      <aside class="legal-sidebar">
        <p class="legal-sidebar-title">On this page</p>
        <nav class="legal-nav">
          <a href="#introduction" class="toc-link">1. Introduction</a>
          <a href="#collection" class="toc-link">2. Data We Collect</a>
