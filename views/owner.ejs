<%- include('partials/head', { title: 'Owner Panel' }) %>
<body>
  <%- include('partials/nav') %>

  <div class="page owner-page">
    <div class="page-header">
      <div class="owner-header-inner">
        <div class="owner-badge">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <h1 class="page-title">Owner Panel</h1>
          <p class="page-subtitle">Bot statistics and administration tools. Only accessible by you.</p>
        </div>
      </div>
    </div>

    <!-- Stats grid -->
    <section class="owner-section">
      <h2 class="owner-section-title">Live Statistics</h2>
      <div class="owner-stats-grid">

        <div class="owner-stat-card">
          <div class="owner-stat-icon owner-stat-icon--guilds">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="owner-stat-body">
            <div class="owner-stat-value"><%= stats.totalGuilds != null ? stats.totalGuilds.toLocaleString() : 'N/A' %></div>
            <div class="owner-stat-label">Guilds configured</div>
          </div>
        </div>

        <div class="owner-stat-card">
          <div class="owner-stat-icon owner-stat-icon--cases">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <div class="owner-stat-body">
            <div class="owner-stat-value"><%= stats.totalCases != null ? stats.totalCases.toLocaleString() : 'N/A' %></div>
            <div class="owner-stat-label">Moderation cases</div>
          </div>
        </div>

        <div class="owner-stat-card">
          <div class="owner-stat-icon owner-stat-icon--apps">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <div class="owner-stat-body">
            <div class="owner-stat-value"><%= stats.totalApplications != null ? stats.totalApplications.toLocaleString() : 'N/A' %></div>
            <div class="owner-stat-label">Application forms</div>
          </div>
        </div>

        <div class="owner-stat-card">
          <div class="owner-stat-icon owner-stat-icon--submissions">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <div class="owner-stat-body">
            <div class="owner-stat-value"><%= stats.totalSubmissions != null ? stats.totalSubmissions.toLocaleString() : 'N/A' %></div>
            <div class="owner-stat-label">App submissions</div>
          </div>
        </div>

        <div class="owner-stat-card">
          <div class="owner-stat-icon owner-stat-icon--levels">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </div>
          <div class="owner-stat-body">
            <div class="owner-stat-value"><%= stats.totalLevelProfiles != null ? stats.totalLevelProfiles.toLocaleString() : 'N/A' %></div>
            <div class="owner-stat-label">Level profiles</div>
          </div>
        </div>

        <div class="owner-stat-card">
          <div class="owner-stat-icon owner-stat-icon--economy">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <div class="owner-stat-body">
            <div class="owner-stat-value"><%= stats.totalEconomyProfiles != null ? stats.totalEconomyProfiles.toLocaleString() : 'N/A' %></div>
            <div class="owner-stat-label">Economy profiles</div>
          </div>
        </div>

      </div>
    </section>

    <!-- System health -->
    <section class="owner-section">
      <h2 class="owner-section-title">System Health</h2>
      <div class="owner-health-grid">

        <div class="owner-health-card">
          <div class="owner-health-label">Uptime</div>
          <div class="owner-health-value" id="ownerUptime" data-seconds="<%= stats.uptimeSeconds %>">
            <%= Math.floor(stats.uptimeSeconds / 3600) %>h <%= Math.floor((stats.uptimeSeconds % 3600) / 60) %>m <%= stats.uptimeSeconds % 60 %>s
          </div>
        </div>

        <div class="owner-health-card">
          <div class="owner-health-label">Heap memory</div>
          <div class="owner-health-value"><%= stats.memoryMB %> MB</div>
        </div>

        <div class="owner-health-card">
          <div class="owner-health-label">Node.js version</div>
          <div class="owner-health-value"><%= stats.nodeVersion %></div>
        </div>

        <div class="owner-health-card">
          <div class="owner-health-label">Environment</div>
          <div class="owner-health-value owner-health-env"><%= process.env.NODE_ENV || 'development' %></div>
        </div>

      </div>
    </section>

    <!-- Quick links -->
    <section class="owner-section">
      <h2 class="owner-section-title">Quick Actions</h2>
      <div class="owner-actions-grid">
        <a href="/dashboard" class="owner-action-card">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span>Server List</span>
        </a>
        <a href="/privacy" class="owner-action-card">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Privacy Policy</span>
        </a>
        <a href="/terms" class="owner-action-card">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span>Terms of Service</span>
        </a>
      </div>
    </section>

  </div>

  <%- include('partials/footer') %>
  <script src="/js/owner.js"></script>
</body>
</html>
